import type { CSSProperties, ReactNode } from "react";
import { cn } from "@/lib/utils";

/** CSS-driven fade-up for above-the-fold content (no JS required, LCP-friendly). */
export function Enter({ children, delay = 0, className, as: Tag = "div" }: { children: ReactNode; delay?: number; className?: string; as?: "div" | "span" | "p" }) {
  return (
    <Tag className={cn("enter", className)} style={{ animationDelay: `${delay}s` } as CSSProperties}>
      {children}
    </Tag>
  );
}

/** CSS-driven word-by-word headline reveal; full text stays available to screen readers. */
export function EnterText({ text, delay = 0, className }: { text: string; delay?: number; className?: string }) {
  const words = text.split(" ");
  return (
    <span className={className}>
      <span className="sr-only">{text}</span>
      <span aria-hidden>
        {words.map((word, i) => (
          <span key={`${word}-${i}`} className="inline-block overflow-hidden pb-[0.12em] align-bottom">
            <span className="enter-line inline-block" style={{ animationDelay: `${delay + i * 0.05}s` }}>
              {word}
              {i < words.length - 1 ? "\u00A0" : ""}
            </span>
          </span>
        ))}
      </span>
    </span>
  );
}
