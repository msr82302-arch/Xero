import { NextResponse } from "next/server";
import { fieldErrors, newsletterSchema } from "@/lib/validation";
import { clientIp, rateLimit } from "@/services/server/rate-limit";
import { saveRecord } from "@/services/server/storage";
import { forwardToWebhook } from "@/services/server/webhook";

/** Connect to your ESP (Klaviyo, Mailchimp, Resend Audiences, ConvertKit) inside this handler. */
export async function POST(req: Request) {
  if (!rateLimit(`newsletter:${clientIp(req)}`, 5, 10 * 60_000).ok) {
    return NextResponse.json({ ok: false, error: "Too many requests. Please try again shortly." }, { status: 429 });
  }
  const parsed = newsletterSchema.safeParse(await req.json().catch(() => null));
  if (!parsed.success) {
    return NextResponse.json({ ok: false, error: "Please enter a valid email.", fieldErrors: fieldErrors(parsed.error) }, { status: 422 });
  }
  const record = await saveRecord("newsletter", { email: parsed.data.email });
  await forwardToWebhook("newsletter.subscribed", { id: record.id, email: parsed.data.email });
  return NextResponse.json({ ok: true, data: { id: record.id } }, { status: 201 });
}
