"use client";

import { motion, useMotionValue, useReducedMotion, useScroll, useSpring, useTransform } from "motion/react";
import { Bot, Calendar, ShieldCheck, TrendingUp } from "lucide-react";
import { useRef, type PointerEvent } from "react";
import { Button } from "@/components/ui/button";
import { Container } from "@/components/ui/container";
import { HeroVisual } from "@/components/three/hero-visual";

function FloatingCard({ className, depth, children, delay }: { className: string; depth: number; children: React.ReactNode; delay: number }) {
  return (
    <div className={`enter absolute hidden md:block ${className}`} style={{ ["--depth" as string]: depth, animationDelay: `${delay}s` }}>
      <div className="glass animate-float rounded-2xl bg-ink-900/60 p-3.5 shadow-2xl shadow-black/40" style={{ animationDelay: `${delay}s` }}>
        {children}
      </div>
    </div>
  );
}

export function Hero() {
  const reduce = useReducedMotion();
  const sectionRef = useRef<HTMLElement>(null);
  // Scroll parallax: copy drifts up and fades, the 3D visual sinks and shrinks as the hero leaves.
  const { scrollYProgress } = useScroll({ target: sectionRef, offset: ["start start", "end start"] });
  const contentY = useTransform(scrollYProgress, [0, 1], [0, reduce ? 0 : -120]);
  const contentOpacity = useTransform(scrollYProgress, [0, 0.75], [1, reduce ? 1 : 0]);
  const scrollVisualY = useTransform(scrollYProgress, [0, 1], [0, reduce ? 0 : 140]);
  const visualScale = useTransform(scrollYProgress, [0, 1], [1, reduce ? 1 : 0.82]);
  const mx = useMotionValue(0);
  const my = useMotionValue(0);
  const sx = useSpring(mx, { stiffness: 60, damping: 20 });
  const sy = useSpring(my, { stiffness: 60, damping: 20 });
  const visualX = useTransform(sx, (v) => v * 18);
  const visualY = useTransform(sy, (v) => v * 18);
  const glowX = useTransform(sx, (v) => `${50 + v * 10}%`);
  const glowY = useTransform(sy, (v) => `${40 + v * 10}%`);
  const glow = useTransform(
    [glowX, glowY],
    ([x, y]) => `radial-gradient(600px circle at ${x} ${y}, rgba(139,92,246,0.18), transparent 60%)`,
  );

  const onPointerMove = (e: PointerEvent<HTMLElement>) => {
    if (reduce || e.pointerType !== "mouse") return;
    const r = e.currentTarget.getBoundingClientRect();
    mx.set((e.clientX - r.left) / r.width - 0.5);
    my.set((e.clientY - r.top) / r.height - 0.5);
  };

  return (
    <section ref={sectionRef} onPointerMove={onPointerMove} className="noise relative isolate flex min-h-[100svh] items-center overflow-hidden pt-28 pb-20 sm:pt-32" aria-labelledby="hero-title">
      {/* Background layers */}
      <div className="grid-bg absolute inset-0 -z-10" aria-hidden />
      <motion.div
        aria-hidden
        className="absolute inset-0 -z-10"
        style={{ background: glow }}
      />
      <div className="animate-pulse-soft absolute top-[-20%] left-[-10%] -z-10 size-[40rem] rounded-full bg-electric/20 blur-[140px]" aria-hidden />
      <div className="animate-pulse-soft absolute right-[-10%] bottom-[-25%] -z-10 size-[42rem] rounded-full bg-violet/20 blur-[140px] [animation-delay:2s]" aria-hidden />

      <Container className="relative grid items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-6">
        <motion.div className="relative z-10" style={{ y: contentY, opacity: contentOpacity }}>
          <p
            className="enter inline-flex items-center gap-2.5 rounded-full border border-line bg-white/[0.03] py-1.5 pr-4 pl-1.5 text-xs text-muted backdrop-blur"
          >
            <span className="rounded-full bg-accent-gradient px-2 py-0.5 text-[0.65rem] font-semibold tracking-wide text-snow uppercase">New</span>
            AI agents & automation for growing businesses
          </p>

          <h1 id="hero-title" className="mt-7 text-[2.6rem] leading-[1.02] font-semibold tracking-[-0.035em] sm:text-6xl lg:text-[4rem] xl:text-[4.6rem]">
            {["Digital Solutions", "Built for"].map((line, i) => (
              <span key={line} className="block overflow-hidden pb-[0.08em]">
                <span className="enter-line block" style={{ animationDelay: `${0.05 + i * 0.1}s` }}>
                  {line}
                </span>
              </span>
            ))}
            <span className="block overflow-hidden pb-[0.08em]">
              <span className="enter-line block" style={{ animationDelay: "0.25s" }}>
                <span className="text-gradient animate-gradient">What&apos;s Next.</span>
              </span>
            </span>
          </h1>

          <p
            style={{ animationDelay: "0.35s" }}
            className="enter mt-7 max-w-xl text-lg leading-relaxed text-muted sm:text-xl"
          >
            We design, build, automate, and scale digital businesses with e-commerce, AI, web, and technology solutions.
          </p>

          <div
            style={{ animationDelay: "0.45s" }}
            className="enter mt-10 flex flex-col gap-3 sm:flex-row sm:items-center"
          >
            <Button href="/book-consultation" size="lg" magnetic arrow>
              Book a Consultation
            </Button>
            <Button href="/services" size="lg" variant="secondary" magnetic>
              Explore Our Services
            </Button>
          </div>

          <div style={{ animationDelay: "0.6s" }} className="enter mt-12 flex items-center gap-4">
            <div className="flex -space-x-2" aria-hidden>
              {["#3b82f6", "#8b5cf6", "#22d3ee", "#34d399"].map((c) => (
                <span key={c} className="size-8 rounded-full border-2 border-ink-950" style={{ background: `linear-gradient(135deg, ${c}, #0d1019)` }} />
              ))}
            </div>
            <p className="text-sm text-muted">
              <span className="font-medium text-fg">Trusted Digital Solutions</span> for Growing Businesses.
            </p>
          </div>
        </motion.div>

        {/* 3D visual + floating UI */}
        <motion.div style={{ y: scrollVisualY, scale: visualScale }}>
        <motion.div
          className="relative mx-auto aspect-square w-full max-w-[34rem] lg:max-w-none"
          style={{ x: visualX, y: visualY }}
        >
          <div className="enter-scale absolute inset-0" style={{ animationDelay: "0.15s" }}>
            <HeroVisual />
          </div>

          <FloatingCard className="top-[12%] left-[-4%]" depth={1} delay={1.0}>
            <div className="flex items-center gap-3">
              <span className="grid size-9 place-items-center rounded-xl bg-violet/20">
                <Bot className="size-4 text-violet" aria-hidden />
              </span>
              <div>
                <p className="text-xs font-medium">AI agent resolved ticket</p>
                <p className="text-[0.7rem] text-subtle">Grounded in 3 sources · 4s</p>
              </div>
            </div>
          </FloatingCard>

          <FloatingCard className="right-[-2%] bottom-[22%]" depth={2} delay={1.2}>
            <div className="w-44">
              <div className="flex items-center justify-between">
                <p className="text-xs text-subtle">Conversion rate</p>
                <TrendingUp className="size-3.5 text-mint" aria-hidden />
              </div>
              <p className="mt-1 font-display text-xl font-semibold">
                4.8% <span className="text-xs font-normal text-mint">sample</span>
              </p>
              <svg viewBox="0 0 160 36" className="mt-2 h-8 w-full" aria-hidden>
                <defs>
                  <linearGradient id="spark" x1="0" x2="1">
                    <stop stopColor="#3b82f6" />
                    <stop offset="1" stopColor="#22d3ee" />
                  </linearGradient>
                </defs>
                <path d="M0 30 L20 26 L40 28 L60 20 L80 22 L100 14 L120 16 L140 8 L160 4" fill="none" stroke="url(#spark)" strokeWidth="2" strokeLinecap="round" />
              </svg>
            </div>
          </FloatingCard>

          <FloatingCard className="bottom-[4%] left-[8%]" depth={1.5} delay={1.4}>
            <div className="flex items-center gap-3">
              <span className="grid size-9 place-items-center rounded-xl bg-cyan/15">
                <Calendar className="size-4 text-cyan" aria-hidden />
              </span>
              <div>
                <p className="text-xs font-medium">Strategy call booked</p>
                <p className="text-[0.7rem] text-subtle">Tue · 10:30 AM</p>
              </div>
            </div>
          </FloatingCard>

          <FloatingCard className="top-[4%] right-[10%]" depth={2.5} delay={1.6}>
            <div className="flex items-center gap-2 text-xs">
              <ShieldCheck className="size-4 text-mint" aria-hidden />
              Core Web Vitals: passing
            </div>
          </FloatingCard>
        </motion.div>
        </motion.div>
      </Container>

      <motion.div
        aria-hidden
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ delay: 1.6 }}
        className="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.7rem] tracking-[0.2em] text-subtle uppercase md:flex"
      >
        Scroll
        <span className="relative h-10 w-px overflow-hidden bg-line">
          <motion.span className="absolute inset-x-0 top-0 h-4 bg-gradient-to-b from-transparent via-white to-transparent" animate={{ y: [-16, 40] }} transition={{ duration: 1.8, repeat: Infinity, ease: "easeInOut" }} />
        </span>
      </motion.div>
    </section>
  );
}
</file>

