<file path="frontend/src/app/api/booking/route.ts">
import { NextResponse } from "next/server";
import { availabilityRules } from "@/data/booking";
import { siteConfig } from "@/data/site";
import { getSlotsForDate } from "@/lib/availability";
import { formatDate, formatTime12h } from "@/lib/utils";
import { bookingSchema, fieldErrors } from "@/lib/validation";
import { createCalendarEvent, getBusySlots } from "@/services/server/calendar";
import { companyInbox, emailLayout, sendEmail } from "@/services/server/email";
import { clientIp, rateLimit } from "@/services/server/rate-limit";
import { getBookedSlots, saveRecord } from "@/services/server/storage";
import { forwardToWebhook } from "@/services/server/webhook";

export async function POST(req: Request) {
  const limited = rateLimit(`booking:${clientIp(req)}`, 5, 10 * 60_000);
  if (!limited.ok) {
    return NextResponse.json(
      { ok: false, error: "Too many requests. Please try again shortly." },
      { status: 429, headers: { "Retry-After": String(limited.retryAfter) } },
    );
  }

  const body = await req.json().catch(() => null);
  const parsed = bookingSchema.safeParse(body);
  if (!parsed.success) {
    return NextResponse.json({ ok: false, error: "Please check the highlighted fields.", fieldErrors: fieldErrors(parsed.error) }, { status: 422 });
  }
  const { website: _honeypot, consent: _consent, ...booking } = parsed.data;

  // Re-check the slot server-side so two people can't book the same time.
  const [booked, busy] = await Promise.all([getBookedSlots(booking.date), getBusySlots(booking.date)]);
  if (!getSlotsForDate(booking.date, [...booked, ...busy]).includes(booking.time)) {
    return NextResponse.json(
      { ok: false, error: "That time is no longer available. Please pick another slot.", fieldErrors: { time: "This slot was just taken" } },
      { status: 409 },
    );
  }

  const record = await saveRecord("bookings", booking);
  const when = `${formatDate(booking.date, { weekday: "long", month: "long", day: "numeric", year: "numeric" })} at ${formatTime12h(booking.time)} (${availabilityRules.timezone.replace("_", " ")})`;

  const rows: [string, string][] = [
    ["Reference", record.id.slice(0, 8).toUpperCase()],
    ["When", when],
    ["Service", booking.service],
    ["Project type", booking.projectType],
    ["Budget", booking.budget],
    ["Name", booking.name],
    ["Email", booking.email],
    ["Phone", booking.phone],
    ["Company", booking.company || "—"],
    ["Requirements", booking.requirements],
  ];

  const internal = emailLayout(`New consultation booking — ${booking.service}`, rows);
  const customer = emailLayout(
    "Your consultation is confirmed",
    rows.slice(0, 5),
    `Hi ${booking.name.split(" ")[0]}, thanks for booking a consultation with ${siteConfig.name}. A senior consultant will review your project details and send a meeting link before the call. Reply to this email if anything changes.`,
  );

  // Side effects run in parallel; failures are logged but don't fail the booking.
  await Promise.allSettled([
    sendEmail({ to: companyInbox(), subject: `New booking: ${booking.service} — ${booking.name}`, ...internal, replyTo: booking.email }),
    sendEmail({ to: booking.email, subject: `Consultation confirmed — ${siteConfig.name}`, ...customer, replyTo: siteConfig.contact.salesEmail }),
    createCalendarEvent({
      date: booking.date,
      time: booking.time,
      durationMinutes: availabilityRules.meetingMinutes,
      timezone: availabilityRules.timezone,
      summary: `Consultation: ${booking.name} (${booking.service})`,
      description: booking.requirements,
      attendeeEmail: booking.email,
      attendeeName: booking.name,
    }),
    forwardToWebhook("booking.created", { id: record.id, ...booking }),
  ]);

  return NextResponse.json({ ok: true, data: { id: record.id, date: booking.date, time: booking.time } }, { status: 201 });
}
