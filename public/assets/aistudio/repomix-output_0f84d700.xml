"use client";

import { Canvas, useFrame } from "@react-three/fiber";
import { useMemo, useRef } from "react";
import * as THREE from "three";

type SceneTheme = "light" | "dark";

/** Per-theme palette: additive glow reads on dark, but vanishes on light — so light uses normal blending and deeper hues. */
const palette = {
  dark: { particles: ["#60a5fa", "#a78bfa", "#22d3ee"], blending: THREE.AdditiveBlending, particleOpacity: 0.85, wire: "#8b9dff", wireOpacity: 0.18, ringA: "#22d3ee", ringB: "#a78bfa", ringOpacity: [0.55, 0.35] },
  light: { particles: ["#2563eb", "#7c3aed", "#0891b2"], blending: THREE.NormalBlending, particleOpacity: 0.7, wire: "#4f46e5", wireOpacity: 0.28, ringA: "#0891b2", ringB: "#7c3aed", ringOpacity: [0.7, 0.5] },
} as const;

function ParticleShell({ count, theme }: { count: number; theme: SceneTheme }) {
  const p = palette[theme];
  const ref = useRef<THREE.Points>(null);
  const { positions, colors } = useMemo(() => {
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);
    const [a, b, c] = p.particles.map((hex) => new THREE.Color(hex));
    const tmp = new THREE.Color();
    for (let i = 0; i < count; i++) {
      // Fibonacci sphere for even distribution, with slight radial jitter
      const y = 1 - (i / (count - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const theta = i * 2.399963229728653;
      const radius = 2.15 + (Math.sin(i * 12.9898) * 0.5 + 0.5) * 0.35;
      positions.set([Math.cos(theta) * r * radius, y * radius, Math.sin(theta) * r * radius], i * 3);
      const t = (y + 1) / 2;
      tmp.copy(t < 0.5 ? a : b).lerp(t < 0.5 ? b : c, t < 0.5 ? t * 2 : (t - 0.5) * 2);
      colors.set([tmp.r, tmp.g, tmp.b], i * 3);
    }
    return { positions, colors };
  }, [count, p]);

  useFrame((_, delta) => {
    if (ref.current) ref.current.rotation.y += delta * 0.05;
  });

  return (
    <points ref={ref}>
      <bufferGeometry>
        <bufferAttribute attach="attributes-position" args={[positions, 3]} />
        <bufferAttribute attach="attributes-color" args={[colors, 3]} />
      </bufferGeometry>
      <pointsMaterial size={theme === "light" ? 0.026 : 0.022} vertexColors transparent opacity={p.particleOpacity} depthWrite={false} blending={p.blending} sizeAttenuation />
    </points>
  );
}

function Core({ theme }: { theme: SceneTheme }) {
  const p = palette[theme];
  const solid = useRef<THREE.Mesh>(null);
  const wire = useRef<THREE.Mesh>(null);
  const ringA = useRef<THREE.Mesh>(null);
  const ringB = useRef<THREE.Mesh>(null);

  useFrame((state, delta) => {
    const t = state.clock.elapsedTime;
    if (solid.current) {
      solid.current.rotation.x += delta * 0.12;
      solid.current.rotation.y += delta * 0.18;
      const s = 1 + Math.sin(t * 0.8) * 0.025;
      solid.current.scale.setScalar(s);
    }
    if (wire.current) {
      wire.current.rotation.x -= delta * 0.08;
      wire.current.rotation.y -= delta * 0.1;
    }
    if (ringA.current) ringA.current.rotation.z += delta * 0.15;
    if (ringB.current) ringB.current.rotation.z -= delta * 0.1;
  });

  return (
    <group>
      <mesh ref={solid}>
        <icosahedronGeometry args={[1.05, 1]} />
        <meshPhysicalMaterial
          color="#4f5fd6"
          emissive="#5b21b6"
          emissiveIntensity={0.45}
          roughness={0.22}
          metalness={0.35}
          iridescence={0.6}
          iridescenceIOR={1.4}
          clearcoat={1}
          clearcoatRoughness={0.15}
          flatShading
        />
      </mesh>
      <mesh ref={wire} scale={1.42}>
        <icosahedronGeometry args={[1, 1]} />
        <meshBasicMaterial color={p.wire} wireframe transparent opacity={p.wireOpacity} />
      </mesh>
      <mesh ref={ringA} rotation={[Math.PI / 2.4, 0.3, 0]}>
        <torusGeometry args={[1.85, 0.006, 8, 160]} />
        <meshBasicMaterial color={p.ringA} transparent opacity={p.ringOpacity[0]} />
      </mesh>
      <mesh ref={ringB} rotation={[Math.PI / 1.7, -0.5, 0.4]}>
        <torusGeometry args={[2.55, 0.004, 8, 200]} />
        <meshBasicMaterial color={p.ringB} transparent opacity={p.ringOpacity[1]} />
      </mesh>
    </group>
  );
}

/** Lerps the whole rig toward the pointer for a subtle parallax. */
function Rig({ children }: { children: React.ReactNode }) {
  const ref = useRef<THREE.Group>(null);
  useFrame((state, delta) => {
    if (!ref.current) return;
    const k = 1 - Math.exp(-delta * 2.5);
    ref.current.rotation.y += (state.pointer.x * 0.35 - ref.current.rotation.y) * k;
    ref.current.rotation.x += (-state.pointer.y * 0.25 - ref.current.rotation.x) * k;
    ref.current.position.y = Math.sin(state.clock.elapsedTime * 0.6) * 0.06;
  });
  return <group ref={ref}>{children}</group>;
}

export default function HeroScene({ active = true, lowPower = false, theme = "light" }: { active?: boolean; lowPower?: boolean; theme?: SceneTheme }) {
  return (
    <Canvas
      frameloop={active ? "always" : "never"}
      dpr={lowPower ? [1, 1.25] : [1, 1.75]}
      camera={{ position: [0, 0, 6.2], fov: 42 }}
      gl={{ antialias: !lowPower, alpha: true, powerPreference: "high-performance" }}
      style={{ background: "transparent" }}
      aria-hidden
    >
      <ambientLight intensity={0.6} />
      <pointLight position={[4, 3, 4]} intensity={140} color="#60a5fa" />
      <pointLight position={[-4, -2, 3]} intensity={120} color="#c084fc" />
      <pointLight position={[0, 4, -3]} intensity={80} color="#22d3ee" />
      <directionalLight position={[2, 5, 6]} intensity={1.2} color="#ffffff" />
      <Rig>
        <Core theme={theme} />
        {/* Remount on theme change so the blending mode is recompiled */}
        <ParticleShell key={theme} count={lowPower ? 700 : 1600} theme={theme} />
      </Rig>
    </Canvas>
  );
}
</file>

<file path="src/components/three/hero-visual.tsx">
"use client";

import dynamic from "next/dynamic";
import { useReducedMotion } from "motion/react";
import { useEffect, useRef, useState } from "react";
import { useMediaQuery } from "@/hooks/use-media-query";
import { useTheme } from "@/hooks/use-theme";
import { onIdle } from "@/lib/idle";

const HeroScene = dynamic(() => import("./hero-scene"), { ssr: false, loading: () => null });

function hasWebGL() {
  try {
    const canvas = document.createElement("canvas");
    return Boolean(canvas.getContext("webgl2") ?? canvas.getContext("webgl"));
  } catch {
    return false;
  }
}

/** Static gradient orb — used as SSR placeholder, reduced-motion and no-WebGL fallback. */
export function StaticOrb() {
  return (
    <div className="absolute inset-0 grid place-items-center" aria-hidden>
      <div className="relative aspect-square w-[62%]">
        <div className="absolute inset-0 rounded-full bg-[conic-gradient(from_180deg,#3b82f6,#8b5cf6,#22d3ee,#3b82f6)] opacity-60 blur-3xl" />
        <div className="absolute inset-[18%] rounded-full border border-white/15 bg-[radial-gradient(circle_at_30%_30%,#6d7dff,#2a1a6b_55%,#0b0e17)] shadow-[inset_0_0_60px_rgba(167,139,250,0.5)]" />
        <div className="absolute inset-[4%] rounded-full border border-white/10" />
      </div>
    </div>
  );
}

/**
 * Loads the WebGL scene only on the client, when idle, on screens ≥768px, when motion is allowed and WebGL exists.
 * Rendering pauses whenever the hero scrolls out of view.
 */
export function HeroVisual() {
  const reduce = useReducedMotion();
  const isSmall = useMediaQuery("(max-width: 767px)");
  const { theme } = useTheme();
  const ref = useRef<HTMLDivElement>(null);
  const [inView, setInView] = useState(true);
  const [enabled, setEnabled] = useState(false);

  // Phones get the CSS orb (saves ~600 KB of WebGL work on slow CPUs). Larger screens load the
  // 3D scene once the browser is idle, so it never competes with first paint or hydration.
  useEffect(() => {
    if (reduce || isSmall || !hasWebGL()) {
      setEnabled(false);
      return;
    }
    return onIdle(() => setEnabled(true));
  }, [reduce, isSmall]);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const io = new IntersectionObserver(([entry]) => setInView(entry.isIntersecting), { threshold: 0 });
    io.observe(el);
    return () => io.disconnect();
  }, []);

  return (
    <div ref={ref} className="absolute inset-0">
      {!enabled && <StaticOrb />}
      {enabled && <HeroScene active={inView} theme={theme} />}
    </div>
  );
}
</file>

