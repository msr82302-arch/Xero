import type { BookingInput, ContactInput, NewsletterInput } from "@/lib/validation";

/**
 * Typed client for the site's API routes.
 * Point API_BASE at an external backend later (e.g. NEXT_PUBLIC_API_URL) without changing components.
 */
const API_BASE = process.env.NEXT_PUBLIC_API_URL ?? "";

export interface ApiResult<T = unknown> {
  ok: boolean;
  data?: T;
  error?: string;
  fieldErrors?: Record<string, string>;
}

async function request<T>(path: string, init?: RequestInit): Promise<ApiResult<T>> {
  try {
    const res = await fetch(`${API_BASE}${path}`, {
      ...init,
      headers: { "Content-Type": "application/json", ...(init?.headers ?? {}) },
    });
    const json = (await res.json().catch(() => ({}))) as ApiResult<T>;
    if (!res.ok) return { ok: false, error: json.error ?? "Something went wrong. Please try again.", fieldErrors: json.fieldErrors };
    return { ok: true, data: json.data };
  } catch {
    return { ok: false, error: "Network error — please check your connection and try again." };
  }
}

export const api = {
  getAvailability: (date?: string) =>
    request<{ dates?: { date: string; slots: number }[]; slots?: string[]; timezone: string }>(
      `/api/availability${date ? `?date=${encodeURIComponent(date)}` : ""}`,
    ),
  submitBooking: (input: BookingInput) =>
    request<{ id: string; date: string; time: string }>("/api/booking", { method: "POST", body: JSON.stringify(input) }),
  submitContact: (input: ContactInput) => request<{ id: string }>("/api/contact", { method: "POST", body: JSON.stringify(input) }),
  subscribe: (input: NewsletterInput) => request<{ id: string }>("/api/newsletter", { method: "POST", body: JSON.stringify(input) }),
};
