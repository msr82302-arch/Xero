"use client";

import { Check, Link2 } from "lucide-react";
import { useState } from "react";

export function ShareButtons({ url, title }: { url: string; title: string }) {
  const [copied, setCopied] = useState(false);
  const u = encodeURIComponent(url);
  const t = encodeURIComponent(title);
  const links = [
    { label: "Share on X", href: `https://x.com/intent/tweet?url=${u}&text=${t}`, text: "X" },
    { label: "Share on LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, text: "in" },
    { label: "Share on Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, text: "f" },
  ];

  const copy = async () => {
    try {
      await navigator.clipboard.writeText(url);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch {
      /* clipboard unavailable */
    }
  };

  return (
    <div className="flex items-center gap-2">
      {links.map((l) => (
        <a
          key={l.label}
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={l.label}
          className="grid size-9 place-items-center rounded-full border border-line text-xs font-semibold text-muted transition hover:border-white/25 hover:text-fg"
        >
          {l.text}
        </a>
      ))}
      <button type="button" onClick={copy} aria-label="Copy link" className="grid size-9 place-items-center rounded-full border border-line text-muted transition hover:border-white/25 hover:text-fg">
        {copied ? <Check className="size-4 text-mint" /> : <Link2 className="size-4" />}
      </button>
      <span aria-live="polite" className="sr-only">
        {copied ? "Link copied" : ""}
      </span>
    </div>
  );
}
