                "relative flex shrink-0 items-center gap-3 rounded-2xl border px-4 py-3.5 text-left text-sm transition-colors lg:w-full",
                isActive ? "border-transparent text-fg" : "border-line text-muted hover:text-fg",
              )}
            >
              {isActive && <motion.span layoutId="svc-active" className="absolute inset-0 rounded-2xl border border-violet/40 bg-violet/10" transition={{ type: "spring", stiffness: 400, damping: 34 }} />}
              <SIcon className="relative size-4" aria-hidden />
              <span className="relative font-medium whitespace-nowrap">{s.name}</span>
              <span className="relative ml-auto hidden text-xs text-subtle lg:inline">{s.offerings.length}</span>
            </button>
          );
        })}
      </div>

      <div id="svc-panel" role="tabpanel" aria-labelledby={`svc-tab-${active}`} className="relative min-w-0 min-h-[32rem] overflow-hidden rounded-[2rem] border border-line bg-ink-900/60 p-6 sm:p-10">
        <div className="pointer-events-none absolute -top-32 -right-32 size-96 rounded-full opacity-40 blur-3xl transition-colors duration-700" style={{ background: `linear-gradient(135deg, ${service.accent[0]}, ${service.accent[1]})` }} aria-hidden />
        <AnimatePresence mode="wait">
          <motion.div key={active} initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -8 }} transition={{ duration: 0.35, ease: [0.16, 1, 0.3, 1] }} className="relative">
            <div className="flex flex-col justify-between gap-6 sm:flex-row sm:items-start">
              <div className="max-w-xl">
                <span className="grid size-12 place-items-center rounded-2xl border border-white/15 bg-white/5">
                  <Icon className="size-5" aria-hidden />
                </span>
                <h3 className="mt-5 text-2xl font-semibold sm:text-3xl">{service.name}</h3>
                <p className="mt-3 text-muted">{service.description}</p>
              </div>
              <div className="shrink-0 rounded-2xl border border-line bg-ink-950/50 px-5 py-4">
                <p className="text-xs text-subtle">Starting from</p>
                <p className="font-display text-2xl font-semibold">{service.startingPrice}</p>
              </div>
            </div>
            <ul className="mt-8 grid gap-x-6 gap-y-3 sm:grid-cols-2">
              {service.offerings.map((o) => (
                <li key={o.name} className="flex gap-3">
                  <Check className="mt-1 size-4 shrink-0 text-cyan" aria-hidden />
                  <span>
                    <span className="block text-sm font-medium text-fg">{o.name}</span>
                    <span className="block text-xs text-subtle">{o.description}</span>
                  </span>
                </li>
              ))}
            </ul>
            <div className="mt-10 flex flex-wrap gap-3">
              <Button href={`/services/${service.slug}`} arrow>
                Learn More
              </Button>
              <Button href="/book-consultation" variant="secondary">
                Book a Consultation
              </Button>
              <Link href="/pricing" className="inline-flex items-center gap-1 px-2 text-sm text-muted hover:text-fg">
                See pricing <ArrowUpRight className="size-3.5" aria-hidden />
              </Link>
            </div>
          </motion.div>
        </AnimatePresence>
      </div>
    </div>
  );
}
