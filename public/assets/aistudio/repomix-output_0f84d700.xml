<file path="src/components/ui/spotlight-card.tsx">
"use client";

import type { PointerEvent, ReactNode } from "react";
import { cn } from "@/lib/utils";

/** Card with a pointer-following glow. The glow itself is pure CSS (see `spotlight` utility). */
export function SpotlightCard({ children, className, as: Tag = "div" }: { children: ReactNode; className?: string; as?: "div" | "article" | "li" }) {
  const onPointerMove = (e: PointerEvent<HTMLElement>) => {
    const el = e.currentTarget;
    const r = el.getBoundingClientRect();
    const px = e.clientX - r.left;
    const py = e.clientY - r.top;
    el.style.setProperty("--mx", `${px}px`);
    el.style.setProperty("--my", `${py}px`);
    if (e.pointerType === "mouse") {
      el.style.setProperty("--ry", `${((px / r.width) - 0.5) * 8}deg`);
      el.style.setProperty("--rx", `${(0.5 - py / r.height) * 8}deg`);
    }
  };
  const onPointerLeave = (e: PointerEvent<HTMLElement>) => {
    e.currentTarget.style.setProperty("--rx", "0deg");
    e.currentTarget.style.setProperty("--ry", "0deg");
  };
  return (
    <Tag
      onPointerMove={onPointerMove}
      onPointerLeave={onPointerLeave}
      className={cn("spotlight tilt rounded-[var(--radius-card)] border border-line bg-ink-900/60 transition-colors duration-300 hover:border-line-strong", className)}
    >
      {children}
    </Tag>
  );
}
