import "server-only";
import { createHmac } from "node:crypto";

/** Optionally forwards submissions to LEADS_WEBHOOK_URL (CRM, Zapier, Make, n8n, custom backend). */
export async function forwardToWebhook(event: string, payload: unknown) {
  const url = process.env.LEADS_WEBHOOK_URL;
  if (!url) return;
  const body = JSON.stringify({ event, payload, sentAt: new Date().toISOString() });
  const headers: Record<string, string> = { "Content-Type": "application/json" };
  if (process.env.LEADS_WEBHOOK_SECRET) {
    headers["X-Signature"] = createHmac("sha256", process.env.LEADS_WEBHOOK_SECRET).update(body).digest("hex");
  }
  try {
    await fetch(url, { method: "POST", headers, body, signal: AbortSignal.timeout(5000) });
  } catch (err) {
    console.error("[webhook] Forward failed", err);
  }
}
