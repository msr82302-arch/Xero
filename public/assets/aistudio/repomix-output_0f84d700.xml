<file path="src/components/visuals/video-player.tsx">
"use client";

import { useReducedMotion } from "motion/react";
import { Pause, Play } from "lucide-react";
import { useEffect, useRef, useState } from "react";
import { cn } from "@/lib/utils";

interface VideoPlayerProps {
  src: string;
  poster: string;
  label: string;
  className?: string;
  /** Show the play/pause control (hide for purely decorative backgrounds). */
  controls?: boolean;
}

/**
 * Muted, looping ambient video.
 * - Loads nothing until it approaches the viewport, and pauses whenever it leaves.
 * - Never autoplays for reduced-motion users (poster only, with a play button).
 */
export function VideoPlayer({ src, poster, label, className, controls = true }: VideoPlayerProps) {
  const ref = useRef<HTMLVideoElement>(null);
  const reduce = useReducedMotion();
  const [inView, setInView] = useState(false);
  const [userPaused, setUserPaused] = useState(false);
  const [playing, setPlaying] = useState(false);
  const [loaded, setLoaded] = useState(false);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const io = new IntersectionObserver(([entry]) => setInView(entry.isIntersecting), { rootMargin: "200px 0px" });
    io.observe(el);
    return () => io.disconnect();
  }, []);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    if (inView && !loaded) {
      el.src = src;
      setLoaded(true);
    }
    const shouldPlay = inView && !userPaused && (!reduce || playing);
    if (shouldPlay) el.play().then(() => setPlaying(true)).catch(() => setPlaying(false));
    else el.pause();
    // `playing` is intentionally not a dependency: it only gates the reduced-motion manual-play case.
  }, [inView, userPaused, reduce, src, loaded]);

  const toggle = () => {
    const el = ref.current;
    if (!el) return;
    if (el.paused) {
      setUserPaused(false);
      el.play().then(() => setPlaying(true)).catch(() => {});
    } else {
      setUserPaused(true);
      el.pause();
      setPlaying(false);
    }
  };

  return (
    <div className={cn("relative overflow-hidden bg-ink-850", className)}>
      <video
        ref={ref}
        poster={poster}
        muted
        loop
        playsInline
        preload="none"
        aria-label={label}
        onPlay={() => setPlaying(true)}
        onPause={() => setPlaying(false)}
        className="absolute inset-0 size-full object-cover"
      />
      {controls && (
        <button
          type="button"
          onClick={toggle}
          aria-label={playing ? `Pause video: ${label}` : `Play video: ${label}`}
          className="absolute right-4 bottom-4 z-10 grid size-11 place-items-center rounded-full border border-snow/30 bg-black/40 text-snow backdrop-blur-md transition hover:scale-105 hover:bg-black/60"
        >
          {playing ? <Pause className="size-4" /> : <Play className="size-4 translate-x-px" />}
        </button>
      )}
    </div>
  );
}
</file>

