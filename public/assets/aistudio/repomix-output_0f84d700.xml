import { NextResponse } from "next/server";
import { siteConfig } from "@/data/site";
import { contactSchema, fieldErrors } from "@/lib/validation";
import { companyInbox, emailLayout, sendEmail } from "@/services/server/email";
import { clientIp, rateLimit } from "@/services/server/rate-limit";
import { saveRecord } from "@/services/server/storage";
import { forwardToWebhook } from "@/services/server/webhook";

export async function POST(req: Request) {
  if (!rateLimit(`contact:${clientIp(req)}`, 5, 10 * 60_000).ok) {
    return NextResponse.json({ ok: false, error: "Too many requests. Please try again shortly." }, { status: 429 });
  }
  const parsed = contactSchema.safeParse(await req.json().catch(() => null));
  if (!parsed.success) {
    return NextResponse.json({ ok: false, error: "Please check the highlighted fields.", fieldErrors: fieldErrors(parsed.error) }, { status: 422 });
  }
  const { website: _honeypot, ...msg } = parsed.data;
  const record = await saveRecord("contacts", msg);
  const rows: [string, string][] = [
    ["Name", msg.name],
    ["Email", msg.email],
    ["Company", msg.company || "—"],
    ["Subject", msg.subject],
    ["Message", msg.message],
  ];
  await Promise.allSettled([
    sendEmail({ to: companyInbox(), subject: `Contact form: ${msg.subject}`, ...emailLayout("New contact message", rows), replyTo: msg.email }),
    sendEmail({
      to: msg.email,
      subject: `We received your message — ${siteConfig.name}`,
      ...emailLayout("Thanks for reaching out", rows.slice(3), `Hi ${msg.name.split(" ")[0]}, we've received your message and will reply within one business day.`),
    }),
    forwardToWebhook("contact.created", { id: record.id, ...msg }),
  ]);
  return NextResponse.json({ ok: true, data: { id: record.id } }, { status: 201 });
}
