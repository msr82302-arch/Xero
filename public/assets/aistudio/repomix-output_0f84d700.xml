import type { CSSProperties, ReactNode } from "react";

interface RevealProps {
  children: ReactNode;
  delay?: number;
  /** Travel distance in px */
  y?: number;
  as?: "div" | "li" | "article" | "section";
  className?: string;
  id?: string;
}

/**
 * Direction-aware scroll reveal — a *server* component (zero hydration cost).
 * One shared IntersectionObserver (<RevealObserver />) sets data-state on every [data-reveal] element:
 *   "in"    → visible (fades/lifts into place)
 *   "below" → waiting below the viewport (offset down)
 *   "above" → scrolled past (offset up), so scrolling back reveals it downward
 * CSS in globals.css handles the transitions; reduced-motion and no-JS visitors always see content.
 */
export function Reveal({ children, delay = 0, y = 28, as: Tag = "div", className, id }: RevealProps) {
  return (
    <Tag id={id} data-reveal="" className={className} style={{ "--reveal-delay": `${delay}s`, "--reveal-y": `${y}px` } as CSSProperties}>
      {children}
    </Tag>
  );
}
</file>

