export type Theme = "light" | "dark";

export const THEME_STORAGE_KEY = "theme";
export const DEFAULT_THEME: Theme = "light";

/**
 * Runs in <head> before first paint so the stored theme is applied without a flash.
 * Light is the default; a saved choice always wins.
 */
export const themeInitScript = `(function(){try{var t=localStorage.getItem("${THEME_STORAGE_KEY}");if(t!=="light"&&t!=="dark")t="${DEFAULT_THEME}";var d=document.documentElement;d.classList.add("js");d.classList.toggle("dark",t==="dark");d.style.colorScheme=t;}catch(e){}})();`;
