<file path="src/app/sitemap.ts">
import type { MetadataRoute } from "next";
import { posts } from "@/data/blog";
import { caseStudies } from "@/data/case-studies";
import { services } from "@/data/services";
import { absoluteUrl } from "@/data/site";

export default function sitemap(): MetadataRoute.Sitemap {
  const now = new Date();
  const staticRoutes: [string, number, MetadataRoute.Sitemap[number]["changeFrequency"]][] = [
    ["/", 1, "weekly"],
    ["/services", 0.9, "monthly"],
    ["/book-consultation", 0.9, "monthly"],
    ["/pricing", 0.8, "monthly"],
    ["/work", 0.8, "monthly"],
    ["/industries", 0.7, "monthly"],
    ["/about", 0.7, "monthly"],
    ["/blog", 0.8, "weekly"],
    ["/contact", 0.7, "yearly"],
    ["/faq", 0.6, "monthly"],
    ["/privacy-policy", 0.2, "yearly"],
    ["/terms", 0.2, "yearly"],
    ["/cookie-policy", 0.2, "yearly"],
  ];
  return [
    ...staticRoutes.map(([path, priority, changeFrequency]) => ({ url: absoluteUrl(path), lastModified: now, changeFrequency, priority })),
    ...services.map((s) => ({ url: absoluteUrl(`/services/${s.slug}`), lastModified: now, changeFrequency: "monthly" as const, priority: 0.9 })),
    ...caseStudies.map((c) => ({ url: absoluteUrl(`/case-studies/${c.slug}`), lastModified: now, changeFrequency: "yearly" as const, priority: 0.6 })),
    ...posts.map((p) => ({ url: absoluteUrl(`/blog/${p.slug}`), lastModified: new Date(p.updatedAt ?? p.publishedAt), changeFrequency: "yearly" as const, priority: 0.6 })),
  ];
}
</file>

