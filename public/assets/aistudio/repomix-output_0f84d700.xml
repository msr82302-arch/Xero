import { NextResponse } from "next/server";
import { availabilityRules } from "@/data/booking";
import { getBookableDates, getSlotsForDate } from "@/lib/availability";
import { getBusySlots } from "@/services/server/calendar";
import { getBookedSlots } from "@/services/server/storage";

export const dynamic = "force-dynamic";

/** GET /api/availability → bookable dates. GET /api/availability?date=YYYY-MM-DD → open slots. */
export async function GET(req: Request) {
  const date = new URL(req.url).searchParams.get("date");
  const timezone = availabilityRules.timezone;

  if (!date) {
    return NextResponse.json({ ok: true, data: { dates: getBookableDates(), timezone } });
  }
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
    return NextResponse.json({ ok: false, error: "Invalid date" }, { status: 400 });
  }
  const [booked, busy] = await Promise.all([getBookedSlots(date), getBusySlots(date)]);
  return NextResponse.json({ ok: true, data: { slots: getSlotsForDate(date, [...booked, ...busy]), timezone } });
}
