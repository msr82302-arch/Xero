<file path="src/lib/availability.ts">
import { availabilityRules } from "@/data/booking";

/** Current date (YYYY-MM-DD) and minutes-since-midnight in the business timezone. */
function nowInZone(timeZone: string) {
  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  }).formatToParts(new Date());
  const get = (t: string) => parts.find((p) => p.type === t)?.value ?? "00";
  return { date: `${get("year")}-${get("month")}-${get("day")}`, minutes: Number(get("hour")) * 60 + Number(get("minute")) };
}

const toMinutes = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};

export function addDays(iso: string, days: number) {
  const [y, m, d] = iso.split("-").map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d + days));
  return dt.toISOString().slice(0, 10);
}

export function dayOfWeek(iso: string) {
  const [y, m, d] = iso.split("-").map(Number);
  return new Date(Date.UTC(y, m - 1, d)).getUTCDay();
}

/** Days between two ISO dates (b - a). */
function diffDays(a: string, b: string) {
  const pa = a.split("-").map(Number);
  const pb = b.split("-").map(Number);
  return Math.round((Date.UTC(pb[0], pb[1] - 1, pb[2]) - Date.UTC(pa[0], pa[1] - 1, pa[2])) / 86_400_000);
}

/**
 * Returns open slots for a date given the rules and already-booked slots.
 * Replace `booked` with data from Google Calendar / Calendly in production.
 */
export function getSlotsForDate(date: string, booked: string[] = []): string[] {
  const { timezone, workingDays, slots, minNoticeHours, bookingWindowDays } = availabilityRules;
  if (!(workingDays as readonly number[]).includes(dayOfWeek(date))) return [];
  const now = nowInZone(timezone);
  const offsetDays = diffDays(now.date, date);
  if (offsetDays < 0 || offsetDays > bookingWindowDays) return [];
  const earliest = now.minutes + minNoticeHours * 60 - offsetDays * 24 * 60;
  return slots.filter((s) => toMinutes(s) >= earliest && !booked.includes(s));
}

export function getBookableDates(): { date: string; slots: number }[] {
  const { timezone, bookingWindowDays } = availabilityRules;
  const today = nowInZone(timezone).date;
  const out: { date: string; slots: number }[] = [];
  for (let i = 0; i <= bookingWindowDays; i++) {
    const date = addDays(today, i);
    out.push({ date, slots: getSlotsForDate(date).length });
  }
  return out;
}

export function todayInBusinessZone() {
  return nowInZone(availabilityRules.timezone).date;
}
</file>

