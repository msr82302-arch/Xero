import { z } from "zod";
import { bookingServices, budgetRanges, projectTypes } from "@/data/booking";

const phoneRegex = /^[+()\-.\s\d]{7,20}$/;
const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
const timeRegex = /^\d{2}:\d{2}$/;

/** Shared between the booking form (client) and /api/booking (server). */
export const bookingSchema = z.object({
  service: z.enum(bookingServices, { message: "Please select a service" }),
  projectType: z.enum(projectTypes, { message: "Please select a project type" }),
  date: z.string({ message: "Please select a date" }).regex(dateRegex, "Please select a date"),
  time: z.string({ message: "Please select a time" }).regex(timeRegex, "Please select a time"),
  name: z.string({ message: "Please enter your full name" }).trim().min(2, "Please enter your full name").max(100),
  email: z.email({ message: "Please enter a valid email address" }).max(200),
  phone: z.string({ message: "Please enter a valid phone number" }).trim().regex(phoneRegex, "Please enter a valid phone number"),
  company: z.string().trim().max(120).optional().or(z.literal("")),
  budget: z.enum(budgetRanges, { message: "Please select a budget range" }),
  requirements: z
    .string({ message: "Please describe your project requirements" })
    .trim()
    .min(20, "Please share a few more details (at least 20 characters)")
    .max(4000, "Please keep this under 4,000 characters"),
  consent: z.literal(true, { message: "Please agree to be contacted about your booking" }),
  /** Honeypot — must stay empty */
  website: z.string().max(0).optional(),
});

export type BookingInput = z.infer<typeof bookingSchema>;

export const contactSchema = z.object({
  name: z.string({ message: "Please enter your name" }).trim().min(2, "Please enter your name").max(100),
  email: z.email({ message: "Please enter a valid email address" }).max(200),
  company: z.string().trim().max(120).optional().or(z.literal("")),
  subject: z.string({ message: "Please add a subject" }).trim().min(3, "Please add a subject").max(150),
  message: z.string({ message: "Please write a short message" }).trim().min(10, "Please write a short message (at least 10 characters)").max(4000),
  website: z.string().max(0).optional(),
});

export type ContactInput = z.infer<typeof contactSchema>;

export const newsletterSchema = z.object({
  email: z.email({ message: "Please enter a valid email address" }).max(200),
  website: z.string().max(0).optional(),
});

export type NewsletterInput = z.infer<typeof newsletterSchema>;

/** Flatten zod issues into { field: message } for form display. */
export function fieldErrors(error: z.ZodError): Record<string, string> {
  const out: Record<string, string> = {};
  for (const issue of error.issues) {
    const key = String(issue.path[0] ?? "form");
    if (!out[key]) out[key] = issue.message;
  }
  return out;
}
