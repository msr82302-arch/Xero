export function WorkGrid({ limit }: { limit?: number }) {
  const [filter, setFilter] = useState<"All" | WorkCategory>("All");
  const [selected, setSelected] = useState<CaseStudy | null>(null);
  const filtered = caseStudies.filter((c) => filter === "All" || c.category === filter);
  const visible = limit ? filtered.slice(0, limit) : filtered;

  return (
    <>
      <LayoutGroup>
        <div role="tablist" aria-label="Filter projects by category" className="-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0">
          {workCategories.map((cat) => {
            const active = cat === filter;
            return (
              <button
                key={cat}
                role="tab"
                type="button"
                aria-selected={active}
                onClick={() => setFilter(cat)}
                className={cn("relative shrink-0 rounded-full px-4 py-2 text-sm transition-colors", active ? "text-ink-950" : "text-muted hover:text-fg")}
              >
                {active && <motion.span layoutId="work-filter" className="absolute inset-0 rounded-full bg-white" transition={{ type: "spring", stiffness: 400, damping: 32 }} />}
                <span className="relative">{cat}</span>
              </button>
            );
          })}
        </div>

        <motion.ul layout className="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3" aria-live="polite">
          <AnimatePresence mode="popLayout">
            {visible.map((study) => (
              <motion.li
                key={study.slug}
                layout
                initial={{ opacity: 0, scale: 0.96, y: 16 }}
                animate={{ opacity: 1, scale: 1, y: 0 }}
                exit={{ opacity: 0, scale: 0.96 }}
                transition={{ duration: 0.45, ease: [0.16, 1, 0.3, 1] }}
              >
                <CaseStudyCard study={study} onQuickView={() => setSelected(study)} />
              </motion.li>
            ))}
          </AnimatePresence>
        </motion.ul>
        {visible.length === 0 && <p className="mt-10 text-muted">More {filter} projects coming soon.</p>}
      </LayoutGroup>

      <Modal open={!!selected} onClose={() => setSelected(null)} title={selected?.title ?? ""}>
        {selected && (
          <div>
            <Photo src={selected.image} alt={`Project visual for ${selected.title}`} sizes="(min-width: 768px) 720px, 100vw" zoom={false} className="relative aspect-[16/9] rounded-2xl" />
            {selected.isPlaceholder && <p className="mt-4 text-xs text-amber-700 dark:text-amber-200">Sample project — illustrative content and target metrics.</p>}
            <div className="mt-6 grid gap-6 sm:grid-cols-2">
              <div>
                <h3 className="text-sm font-semibold text-fg">Challenge</h3>
                <p className="mt-2 text-sm leading-relaxed text-muted">{selected.challenge}</p>
              </div>
              <div>
                <h3 className="text-sm font-semibold text-fg">Solution</h3>
                <ul className="mt-2 space-y-1.5 text-sm text-muted">
                  {selected.solution.map((s) => (
                    <li key={s}>— {s}</li>
                  ))}
                </ul>
              </div>
            </div>
            <div className="mt-6 flex flex-wrap gap-2">
              {selected.technologies.map((t) => (
                <span key={t} className="rounded-full border border-line px-3 py-1 text-xs text-muted">
                  {t}
                </span>
              ))}
            </div>
            <div className="mt-8 flex flex-wrap gap-3">
              <Button href={`/case-studies/${selected.slug}`} arrow>
                View Case Study
              </Button>
              <Button href="/book-consultation" variant="secondary">
                Start Your Project
              </Button>
            </div>
          </div>
        )}
      </Modal>
    </>
  );
}
