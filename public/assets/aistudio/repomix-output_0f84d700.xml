"use client";

import type { PointerEvent } from "react";

/** Oversized footer wordmark: a gradient spotlight follows the cursor across the letters. */
export function WordmarkSpotlight({ text }: { text: string }) {
  const onMove = (e: PointerEvent<HTMLParagraphElement>) => {
    const r = e.currentTarget.getBoundingClientRect();
    e.currentTarget.style.setProperty("--wx", `${e.clientX - r.left}px`);
    e.currentTarget.style.setProperty("--wy", `${e.clientY - r.top}px`);
    e.currentTarget.style.setProperty("--wo", "1");
  };
  const onLeave = (e: PointerEvent<HTMLParagraphElement>) => e.currentTarget.style.setProperty("--wo", "0");

  return (
    <div aria-hidden className="mt-16 overflow-hidden select-none">
      <p onPointerMove={onMove} onPointerLeave={onLeave} className="relative font-display text-[17vw] leading-[0.8] font-semibold tracking-tighter lg:text-[13rem]">
        <span className="text-gradient opacity-[0.08]">{text}</span>
        <span
          className="absolute inset-0 bg-[radial-gradient(260px_circle_at_var(--wx,50%)_var(--wy,50%),#3b82f6,#8b5cf6_45%,#06b6d4_70%,transparent_75%)] bg-clip-text text-transparent transition-opacity duration-500"
          style={{ opacity: "var(--wo, 0)" }}
        >
          {text}
        </span>
      </p>
    </div>
  );
}
