import { Providers } from "@/components/layout/providers";
import { JsonLd } from "@/components/ui/json-ld";
import "./globals.css";

const inter = Inter({ subsets: ["latin"], variable: "--font-inter", display: "swap" });
const sora = Sora({ subsets: ["latin"], variable: "--font-sora", display: "swap", weight: ["400", "500", "600", "700"] });

export const metadata: Metadata = {
  metadataBase: new URL(siteConfig.url),
  title: {
    default: `${siteConfig.name} — AI, E-Commerce & Web Development Agency`,
    template: `%s | ${siteConfig.name}`,
  },
  description: siteConfig.description,
  applicationName: siteConfig.name,
  keywords: [
    "AI development services",
    "AI automation agency",
    "Shopify development agency",
    "e-commerce development",
    "Amazon account management",
    "Walmart marketplace management",
    "web development agency",
    "mobile app development",
    "SEO services",
    "digital transformation",
    "business automation",
  ],
  authors: [{ name: siteConfig.name, url: siteConfig.url }],
  creator: siteConfig.name,
  alternates: { canonical: siteConfig.url },
  openGraph: {
    type: "website",
    siteName: siteConfig.name,
    locale: siteConfig.locale,
    url: siteConfig.url,
    title: `${siteConfig.name} — Digital Solutions Built for What's Next`,
    description: siteConfig.description,
  },
  twitter: { card: "summary_large_image", title: siteConfig.name, description: siteConfig.description },
  robots: { index: true, follow: true, googleBot: { index: true, follow: true, "max-image-preview": "large" } },
  formatDetection: { telephone: false },
};

export const viewport: Viewport = {
  themeColor: [
    { media: "(prefers-color-scheme: light)", color: "#f6f7fb" },
    { media: "(prefers-color-scheme: dark)", color: "#05060a" },
  ],
  colorScheme: "light dark",
  width: "device-width",
  initialScale: 1,
};

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en" className={`${inter.variable} ${sora.variable}`} suppressHydrationWarning>
      <head>
        <script dangerouslySetInnerHTML={{ __html: themeInitScript }} />
      </head>
      <body className="min-h-dvh">
        <a href="#main" className="fixed top-3 left-3 z-[200] -translate-y-20 rounded-full bg-white px-4 py-2 text-sm font-medium text-ink-950 transition focus:translate-y-0">
          Skip to content
        </a>
        <JsonLd data={[organizationSchema(), websiteSchema(), localBusinessSchema()]} />
        <Providers>
          <SmoothScroll />
          <RevealObserver />
          <ParticleField />
          <ScrollProgress />
          <CustomCursor />
          <Navbar />
          <main id="main">{children}</main>
          <Footer />
          <CookieNotice />
        </Providers>
        {/* Vercel Analytics & Speed Insights: cookieless, and only loaded when deployed on Vercel */}
        {process.env.VERCEL && (
          <>
            <Analytics />
            <SpeedInsights />
          </>
        )}
      </body>
    </html>
  );
}
