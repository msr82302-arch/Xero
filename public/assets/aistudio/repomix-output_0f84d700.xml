  return (
    <SpotlightCard as="article" className="group flex h-full flex-col overflow-hidden">
      <div className="relative aspect-[16/9]">
        <Photo src={service.image} alt={`${service.name} — illustrative photo`} sizes="(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 100vw" shade className="absolute inset-0" />
        <span className="theme-dark absolute top-3 left-3 rounded-full border border-white/20 bg-black/35 px-2.5 py-1 text-[0.7rem] font-medium text-white backdrop-blur-md">
          From {service.startingPrice}
        </span>
      </div>
      <div className="flex flex-1 flex-col p-6 sm:p-7">
      <div className="-mt-14 flex items-end justify-between">
        <div className="relative">
          <div className="absolute inset-0 rounded-2xl opacity-50 blur-xl transition-opacity duration-500 group-hover:opacity-90" style={{ background: `linear-gradient(135deg, ${service.accent[0]}, ${service.accent[1]})` }} aria-hidden />
          <div className="relative grid size-14 place-items-center rounded-2xl border border-white/15 bg-ink-900/80 transition-transform duration-500 group-hover:-translate-y-1 group-hover:rotate-[-4deg]">
            <Icon className="size-6 text-white" aria-hidden />
          </div>
        </div>
        {index !== undefined && <span className="font-display text-sm text-subtle">{String(index + 1).padStart(2, "0")}</span>}
      </div>

      <h3 className="mt-5 text-xl font-semibold">
        <Link href={`/services/${service.slug}`} className="after:absolute after:inset-0 after:rounded-[inherit]">
          {service.name}
        </Link>
      </h3>
      <p className="mt-3 text-sm leading-relaxed text-muted">{service.description}</p>

      <ul className="mt-5 flex flex-wrap gap-1.5" aria-label={`Popular ${service.shortName} services`}>
        {service.offerings.slice(0, 4).map((o) => (
          <li key={o.name} className="rounded-full border border-line px-2.5 py-1 text-xs text-muted">
            {o.name}
          </li>
        ))}
        {service.offerings.length > 4 && <li className="rounded-full px-2 py-1 text-xs text-subtle">+{service.offerings.length - 4} more</li>}
      </ul>

      <div className="mt-auto pt-7">
        <div className="flex items-end justify-between gap-4 border-t border-line pt-5">
          <div>
            <p className="text-xs text-subtle">Starting from</p>
            <p className="font-display text-lg font-semibold">{service.startingPrice}</p>
          </div>
          <span className="inline-flex items-center gap-1 text-sm font-medium text-fg">
            Learn More
            <ArrowUpRight className="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden />
          </span>
        </div>
        <p className="relative z-10 mt-4 text-xs text-subtle">
          Related:{" "}
          {related.map((r, i) => (
            <span key={r.slug}>
              <Link href={`/services/${r.slug}`} className="text-muted underline-offset-2 hover:text-fg hover:underline">
                {r.shortName}
              </Link>
              {i < related.length - 1 ? ", " : ""}
            </span>
          ))}
        </p>
      </div>
      </div>
    </SpotlightCard>
  );
}
