"use client";

import { AnimatePresence, motion } from "motion/react";
import { useState } from "react";
import { pricing } from "@/data/pricing";
import type { PricingCategoryId } from "@/types";
import { cn } from "@/lib/utils";
import { PricingCard } from "@/components/cards/pricing-card";
import { Button } from "@/components/ui/button";

const categoryToBookingService: Record<PricingCategoryId, string> = {
  web: "Web Development",
  ecommerce: "Shopify",
  ai: "AI Solutions",
  mobile: "Mobile App",
  uiux: "UI/UX",
  marketing: "SEO",
  automation: "Automation",
};

export function PricingTabs() {
  const [active, setActive] = useState<PricingCategoryId>("web");
  const category = pricing.find((p) => p.id === active)!;

  return (
    <div>
      <div role="tablist" aria-label="Pricing categories" className="-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] lg:mx-0 lg:justify-center lg:px-0">
        {pricing.map((p) => (
          <button
            key={p.id}
            id={`tab-${p.id}`}
            role="tab"
            type="button"
            aria-selected={p.id === active}
            aria-controls="pricing-panel"
            onClick={() => setActive(p.id)}
            className={cn(
              "relative shrink-0 rounded-full border px-4 py-2 text-sm transition-colors",
              p.id === active ? "border-transparent text-ink-950" : "border-line text-muted hover:text-fg",
            )}
          >
            {p.id === active && <motion.span layoutId="pricing-pill" className="absolute inset-0 rounded-full bg-white" transition={{ type: "spring", stiffness: 400, damping: 32 }} />}
            <span className="relative">{p.label}</span>
          </button>
        ))}
      </div>

      <div id="pricing-panel" role="tabpanel" aria-labelledby={`tab-${active}`} className="mt-12">
        <AnimatePresence mode="wait">
          <motion.ul
            key={active}
            initial={{ opacity: 0, y: 16 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -10 }}
            transition={{ duration: 0.35, ease: [0.16, 1, 0.3, 1] }}
            className="grid gap-5 pt-3 sm:grid-cols-2 xl:grid-cols-4"
          >
            {category.tiers.map((tier) => (
              <li key={tier.name}>
                <PricingCard tier={tier} category={categoryToBookingService[active]} />
              </li>
            ))}
          </motion.ul>
        </AnimatePresence>
      </div>

      <div className="glass mt-10 flex flex-col items-start justify-between gap-6 rounded-[var(--radius-card)] p-6 sm:flex-row sm:items-center sm:p-8">
        <div>
          <p className="font-display text-xl font-semibold">Custom Project?</p>
          <p className="mt-1 text-sm text-muted">Every business is different. Tell us about your goals and we&apos;ll put together a tailored proposal.</p>
        </div>
        <Button href="/contact?subject=Custom%20quote" arrow>
          Request a Custom Quote
        </Button>
      </div>
      <p className="mt-6 text-center text-xs text-subtle">Prices are indicative starting points in USD. Final quotes depend on scope and are confirmed after a free consultation.</p>
    </div>
  );
}
