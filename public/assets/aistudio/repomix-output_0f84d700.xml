"use client";

import { AnimatePresence, motion } from "motion/react";
import { useState } from "react";
import { pricing } from "@/data/pricing";
import type { PricingCategoryId } from "@/types";
import { cn } from "@/lib/utils";
import { PricingCard } from "@/components/cards/pricing-card";
import { Button } from "@/components/ui/button";

const categoryToBookingService: Record<PricingCategoryId, string> = {
  web: "Web Development",
  ecommerce: "Shopify",
  ai: "AI Solutions",
  mobile: "Mobile App",
  uiux: "UI/UX",
  marketing: "SEO",
  automation: "Automation",
};

export function PricingTabs() {
  const [active, setActive] = useState<PricingCategoryId>("web");
  const category = pricing.find((p) => p.id === active)!;

  return (
    <div>
      <div role="tablist" aria-label="Pricing categories" className="-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] lg:mx-0 lg:justify-center lg:px-0">
        {pricing.map((p) => (
          <button
            key={p.id}
            id={`tab-${p.id}`}
            role="tab"
            type="button"
            aria-selected={p.id === active}
            aria-controls="pricing-panel"
            onClick={() => setActive(p.id)}
            className={cn(
              "relative shrink-0 rounded-full border px-4 py-2 text-sm transition-colors",
