<file path="frontend/src/components/effects/custom-cursor.tsx">
"use client";

import { AnimatePresence, motion, useMotionValue } from "motion/react";
import { useEffect, useId, useState } from "react";

const INTERACTIVE = 'a, button, [role="button"], [role="tab"], [role="radio"], summary, label, select';
const TEXT_INPUT = 'input:not([type="checkbox"]):not([type="radio"]), textarea, [contenteditable="true"]';

type Mode = "arrow" | "hand" | "hidden";

/** Gradient arrow (default). Tip sits at (4.2, 4.2) in the 24×24 box. */
function ArrowGlyph({ gradientId }: { gradientId: string }) {
  return (
    <svg viewBox="0 0 24 24" width="28" height="28" className="overflow-visible">
      <path
        d="M4.04 4.69a.5.5 0 0 1 .65-.65l16 6.5a.5.5 0 0 1-.06.95l-6.13 1.58a2 2 0 0 0-1.43 1.43l-1.58 6.13a.5.5 0 0 1-.95.06z"
        fill={`url(#${gradientId})`}
        stroke="currentColor"
        strokeWidth="1.6"
        strokeLinejoin="round"
      />
      <path d="M7.2 7.4l7.2 2.9" stroke="#fff" strokeOpacity="0.55" strokeWidth="1.1" strokeLinecap="round" />
    </svg>
  );
}

/** Pointing hand, index finger up. Fingertip sits at (14, 1.5) in the 32×32 box. */
function HandGlyph({ gradientId }: { gradientId: string }) {
  return (
    <svg viewBox="0 0 32 32" width="34" height="34" className="overflow-visible">
      <path
        d="M11 4.5C11 2.6 12.3 1.5 14 1.5s3 1.1 3 3V13c0-1.4 1.2-2.2 2.5-2.2S22 11.8 22 13.2c.3-.9 1.3-1.4 2.3-1.3 1.4.1 2.3 1.2 2.3 2.5.4-.5 1.2-.8 1.9-.6 1.1.3 1.7 1.2 1.7 2.4V21c0 5.5-4 9.5-9.5 9.5h-3.2c-2.7 0-4.5-.9-6.2-2.6l-5.7-5.7a2.3 2.3 0 0 1 3.6-3.6l1.8 1.8z"
        fill={`url(#${gradientId})`}
        stroke="currentColor"
        strokeWidth="1.7"
        strokeLinejoin="round"
      />
      {/* knuckle creases */}
      <path d="M17 13v3.4M22 13.4v3.4M26.6 14.6v3" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" />
      {/* highlight on the index finger */}
      <path d="M13 4.6v6.2" stroke="#fff" strokeOpacity="0.6" strokeWidth="1.2" strokeLinecap="round" />
    </svg>
  );
}

/**
 * Theme-coloured cursor: a gradient arrow that turns into a pointing hand over interactive elements.
 * Only on fine pointers (mouse/trackpad) and when motion is allowed; the native caret returns over text fields.
 */
export function CustomCursor() {
  const gradientId = useId().replace(/:/g, "");
  const [enabled, setEnabled] = useState(false);
  const [mode, setMode] = useState<Mode>("hidden");
  const [pressed, setPressed] = useState(false);
  const x = useMotionValue(-100);
  const y = useMotionValue(-100);

  useEffect(() => {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!fine || reduce) return;
    setEnabled(true);
    document.documentElement.classList.add("has-custom-cursor");

    const onMove = (e: PointerEvent) => {
      x.set(e.clientX);
      y.set(e.clientY);
      const target = e.target as Element | null;
      if (target?.closest(TEXT_INPUT)) setMode("hidden");
      else if (target?.closest(INTERACTIVE)) setMode("hand");
      else setMode("arrow");
    };
    const onLeave = () => setMode("hidden");
    const onDown = () => setPressed(true);
    const onUp = () => setPressed(false);

    window.addEventListener("pointermove", onMove, { passive: true });
    window.addEventListener("pointerdown", onDown);
    window.addEventListener("pointerup", onUp);
    document.documentElement.addEventListener("pointerleave", onLeave);
    return () => {
      document.documentElement.classList.remove("has-custom-cursor");
      window.removeEventListener("pointermove", onMove);
      window.removeEventListener("pointerdown", onDown);
      window.removeEventListener("pointerup", onUp);
      document.documentElement.removeEventListener("pointerleave", onLeave);
    };
  }, [x, y]);

  if (!enabled) return null;

  return (
    <div aria-hidden className="pointer-events-none fixed inset-0 z-[300]">
      <svg width="0" height="0" className="absolute">
        <defs>
          <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stopColor="#60a5fa" />
            <stop offset="0.5" stopColor="#8b5cf6" />
            <stop offset="1" stopColor="#22d3ee" />
          </linearGradient>
        </defs>
      </svg>
      <motion.div className="absolute top-0 left-0 text-white drop-shadow-[0_4px_10px_rgba(124,58,237,0.45)]" style={{ x, y }}>
        <AnimatePresence initial={false}>
          {mode === "arrow" && (
            <motion.div
              key="arrow"
              className="absolute"
              style={{ left: -5, top: -5, transformOrigin: "5px 5px" }}
              initial={{ opacity: 0, scale: 0.6 }}
              animate={{ opacity: 1, scale: pressed ? 0.85 : 1 }}
              exit={{ opacity: 0, scale: 0.6 }}
              transition={{ type: "spring", stiffness: 500, damping: 28 }}
            >
              <ArrowGlyph gradientId={gradientId} />
            </motion.div>
          )}
          {mode === "hand" && (
            <motion.div
              key="hand"
              className="absolute"
              style={{ left: -15, top: -2, transformOrigin: "15px 2px" }}
              initial={{ opacity: 0, scale: 0.6, rotate: -12 }}
              animate={{ opacity: 1, scale: pressed ? 0.85 : 1, rotate: pressed ? 6 : 0 }}
              exit={{ opacity: 0, scale: 0.6, rotate: -12 }}
              transition={{ type: "spring", stiffness: 500, damping: 26 }}
            >
              <HandGlyph gradientId={gradientId} />
            </motion.div>
          )}
        </AnimatePresence>
      </motion.div>
    </div>
  );
}
</file>

<file path="frontend/src/components/effects/particle-field.tsx">
"use client";

import { useEffect, useRef } from "react";
import { onIdle } from "@/lib/idle";

interface Particle {
  x: number;
  y: number;
  vx: number;
  vy: number;
  r: number;
  a: number;
}

interface Ripple {
  x: number;
  y: number;
  t: number;
}

const LINK_DIST = 120;
const CURSOR_DIST = 160;

/**
 * Lightweight interactive constellation background (Canvas 2D, no dependencies).
 * - Dots drift slowly and link to near neighbours.
 * - Hovering pushes dots away and draws threads to the cursor; clicking sends out a shock-wave.
 * - Colours follow the active theme. Pauses when the tab is hidden; static under reduced motion.
 */
export function ParticleField() {
  const canvasRef = useRef<HTMLCanvasElement>(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const root = document.documentElement;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let particles: Particle[] = [];
    const ripples: Ripple[] = [];
    const mouse = { x: -9999, y: -9999, active: false };
    let raf = 0;
    let colors = { dot: "79,70,229", line: "99,102,241", accent: "124,58,237", dotAlpha: 0.45 };

    const readTheme = () => {
      const dark = root.classList.contains("dark");
      colors = dark
        ? { dot: "196,181,253", line: "139,92,246", accent: "34,211,238", dotAlpha: 0.7 }
        : { dot: "79,70,229", line: "99,102,241", accent: "124,58,237", dotAlpha: 0.45 };
    };

    const seed = () => {
      const target = Math.round(Math.min(110, Math.max(30, (width * height) / 15000)));
      particles = Array.from({ length: target }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        r: 0.6 + Math.random() * 1.4,
        a: 0.35 + Math.random() * 0.65,
      }));
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
      if (reduce) draw();
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        if (!reduce) {
          // Cursor repulsion
          if (mouse.active) {
            const dx = p.x - mouse.x;
            const dy = p.y - mouse.y;
            const d2 = dx * dx + dy * dy;
            if (d2 < CURSOR_DIST * CURSOR_DIST && d2 > 0.01) {
              const d = Math.sqrt(d2);
              const force = (1 - d / CURSOR_DIST) * 0.6;
              p.vx += (dx / d) * force;
              p.vy += (dy / d) * force;
            }
          }
          p.vx *= 0.94;
          p.vy *= 0.94;
          // Keep a gentle minimum drift
          p.x += p.vx + Math.sign(p.vx || 1) * 0.08;
          p.y += p.vy + Math.sign(p.vy || 1) * 0.06;
          if (p.x < -10) p.x = width + 10;
          if (p.x > width + 10) p.x = -10;
          if (p.y < -10) p.y = height + 10;
          if (p.y > height + 10) p.y = -10;
        }

        // Links to neighbours
        for (let j = i + 1; j < particles.length; j++) {
          const q = particles[j];
          const dx = p.x - q.x;
          const dy = p.y - q.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < LINK_DIST * LINK_DIST) {
            const alpha = (1 - Math.sqrt(d2) / LINK_DIST) * 0.18;
            ctx.strokeStyle = `rgba(${colors.line},${alpha})`;
            ctx.lineWidth = 0.6;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.stroke();
          }
        }

        // Threads to the cursor
        let near = 0;
        if (mouse.active) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < CURSOR_DIST * 1.3) {
            near = 1 - d / (CURSOR_DIST * 1.3);
            ctx.strokeStyle = `rgba(${colors.accent},${near * 0.45})`;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.stroke();
          }
        }

        ctx.fillStyle = near > 0 ? `rgba(${colors.accent},${Math.min(1, colors.dotAlpha + near)})` : `rgba(${colors.dot},${p.a * colors.dotAlpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r + near * 1.4, 0, Math.PI * 2);
        ctx.fill();
      }

      // Click shock-waves
      for (let k = ripples.length - 1; k >= 0; k--) {
        const r = ripples[k];
        r.t += 1;
        const radius = r.t * 6;
        const alpha = Math.max(0, 1 - r.t / 45);
        ctx.strokeStyle = `rgba(${colors.accent},${alpha * 0.5})`;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.arc(r.x, r.y, radius, 0, Math.PI * 2);
        ctx.stroke();
        if (alpha <= 0) ripples.splice(k, 1);
      }
    };

    const loop = () => {
      draw();
      raf = requestAnimationFrame(loop);
    };

    const onMove = (e: PointerEvent) => {
      if (e.pointerType === "touch") return;
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;
    };
    const onLeave = () => {
      mouse.active = false;
    };
    const onDown = (e: PointerEvent) => {
      ripples.push({ x: e.clientX, y: e.clientY, t: 0 });
      for (const p of particles) {
        const dx = p.x - e.clientX;
        const dy = p.y - e.clientY;
        const d = Math.sqrt(dx * dx + dy * dy) || 1;
        if (d < 260) {
          const f = (1 - d / 260) * 9;
          p.vx += (dx / d) * f;
          p.vy += (dy / d) * f;
        }
      }
    };
    const onVisibility = () => {
      cancelAnimationFrame(raf);
      if (!document.hidden && !reduce && started) raf = requestAnimationFrame(loop);
    };

    let resizeTimer: ReturnType<typeof setTimeout>;
    const onResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => started && resize(), 150);
    };

    let started = false;
    const start = () => {
      started = true;
      readTheme();
      resize();
      if (!reduce) raf = requestAnimationFrame(loop);
    };
    // Start after first paint/hydration so the canvas never delays the page becoming interactive.
    const cancelIdle = onIdle(start);
    const themeObserver = new MutationObserver(() => {
      readTheme();
      if (reduce && started) draw();
    });
    themeObserver.observe(root, { attributes: true, attributeFilter: ["class"] });

    window.addEventListener("resize", onResize);
    if (!reduce) {
      window.addEventListener("pointermove", onMove, { passive: true });
      window.addEventListener("pointerdown", onDown, { passive: true });
      document.addEventListener("pointerleave", onLeave);
      document.addEventListener("visibilitychange", onVisibility);
    }

    return () => {
      cancelIdle();
      cancelAnimationFrame(raf);
      clearTimeout(resizeTimer);
      themeObserver.disconnect();
      window.removeEventListener("resize", onResize);
      window.removeEventListener("pointermove", onMove);
      window.removeEventListener("pointerdown", onDown);
      document.removeEventListener("pointerleave", onLeave);
      document.removeEventListener("visibilitychange", onVisibility);
    };
  }, []);

  return <canvas ref={canvasRef} aria-hidden className="pointer-events-none fixed inset-0 -z-10" />;
}
</file>

<file path="frontend/src/components/effects/reveal-observer.tsx">
"use client";

import { usePathname } from "next/navigation";
import { useEffect } from "react";

/** Drives every <Reveal> on the page with a single IntersectionObserver (see components/ui/reveal.tsx). */
export function RevealObserver() {
  const pathname = usePathname();

  useEffect(() => {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) el.dataset.state = "in";
          else el.dataset.state = entry.boundingClientRect.top < 0 ? "above" : "below";
        }
      },
      { rootMargin: "-6% 0px -6% 0px" },
    );
    const observe = (root: ParentNode) => root.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => io.observe(el));
    observe(document);

    // Pick up elements rendered later (filters, tabs, client navigation).
    const mo = new MutationObserver((mutations) => {
      for (const m of mutations) {
        m.addedNodes.forEach((node) => {
          if (!(node instanceof HTMLElement)) return;
          if (node.matches("[data-reveal]")) io.observe(node);
          observe(node);
        });
      }
    });
    mo.observe(document.body, { childList: true, subtree: true });
    return () => {
      io.disconnect();
      mo.disconnect();
    };
  }, [pathname]);

  return null;
}
</file>

<file path="frontend/src/components/effects/scroll-fade.tsx">
"use client";

import { motion, useReducedMotion, useScroll, useTransform } from "motion/react";
import { useEffect, useRef, useState, type ReactNode } from "react";

/**
 * Scroll-linked section transition: content fades/lifts in as the section enters
 * and fades/lifts out as it leaves — in both scroll directions.
 */
export function ScrollFade({ children, className, distance = 56 }: { children: ReactNode; className?: string; distance?: number }) {
  const ref = useRef<HTMLDivElement>(null);
  const reduce = useReducedMotion();
  // Server render + first paint stay fully visible (fast LCP); scroll-linked styles attach after hydration.
  const [mounted, setMounted] = useState(false);
  useEffect(() => setMounted(true), []);
  const { scrollYProgress: enter } = useScroll({ target: ref, offset: ["start end", "start 65%"] });
  const { scrollYProgress: exit } = useScroll({ target: ref, offset: ["end 35%", "end start"] });
  const opacity = useTransform([enter, exit], ([a, b]: number[]) => Math.min(0.15 + 0.85 * a, 1 - 0.85 * b));
  const y = useTransform([enter, exit], ([a, b]: number[]) => (1 - a) * distance - b * distance);
  const scale = useTransform([enter, exit], ([a, b]: number[]) => 1 - (1 - a) * 0.03 - b * 0.03);

  if (reduce)
    return (
      <div ref={ref} className={className}>
        {children}
      </div>
    );
  return (
    <motion.div ref={ref} className={className} style={mounted ? { opacity, y, scale } : undefined}>
      {children}
    </motion.div>
  );
}
</file>

