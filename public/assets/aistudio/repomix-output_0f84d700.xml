"use client";

import Link from "next/link";
import { AnimatePresence, motion } from "motion/react";
import { ArrowUpRight, Check } from "lucide-react";
import { useState } from "react";
import { services } from "@/data/services";
import { cn } from "@/lib/utils";
import { Button } from "@/components/ui/button";

/** Interactive explorer of every service offering, grouped by practice. */
export function ServicesExplorer() {
  const [active, setActive] = useState(services[0].slug);
  const service = services.find((s) => s.slug === active)!;
  const Icon = service.icon;

  return (
    <div className="grid gap-6 lg:grid-cols-[320px_1fr]">
      <div role="tablist" aria-label="Service categories" aria-orientation="vertical" className="-mx-4 flex min-w-0 gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] lg:mx-0 lg:flex-col lg:overflow-visible lg:px-0">
        {services.map((s) => {
          const SIcon = s.icon;
          const isActive = s.slug === active;
          return (
            <button
              key={s.slug}
              id={`svc-tab-${s.slug}`}
              role="tab"
              type="button"
              aria-selected={isActive}
              aria-controls="svc-panel"
