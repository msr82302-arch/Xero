"use client";

import { AnimatePresence, motion, useMotionValueEvent, useScroll, useSpring } from "motion/react";
import { ArrowUp } from "lucide-react";
import { useState } from "react";
import { scrollToTop } from "@/lib/smooth-scroll";

/** Top progress bar + back-to-top button with a circular progress ring. */
export function ScrollProgress() {
  const { scrollYProgress, scrollY } = useScroll();
  const progress = useSpring(scrollYProgress, { stiffness: 200, damping: 40, mass: 0.3 });
  const [visible, setVisible] = useState(false);

  useMotionValueEvent(scrollY, "change", (v) => setVisible(v > 600));

  return (
    <>
      <motion.div aria-hidden className="fixed inset-x-0 top-0 z-[70] h-[2px] origin-left bg-accent-gradient" style={{ scaleX: progress }} />
      <AnimatePresence>
        {visible && (
          <motion.button
            type="button"
            onClick={scrollToTop}
            aria-label="Back to top"
            initial={{ opacity: 0, scale: 0.6, y: 20 }}
            animate={{ opacity: 1, scale: 1, y: 0 }}
            exit={{ opacity: 0, scale: 0.6, y: 20 }}
            whileHover={{ scale: 1.08 }}
            whileTap={{ scale: 0.92 }}
            className="group fixed right-5 bottom-5 z-[60] grid size-12 place-items-center rounded-full border border-line bg-ink-900/80 text-fg shadow-lg shadow-black/10 backdrop-blur-xl sm:right-8 sm:bottom-8"
          >
            <svg viewBox="0 0 48 48" className="absolute inset-0 size-full -rotate-90" aria-hidden>
              <defs>
                <linearGradient id="btt-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stopColor="#3b82f6" />
                  <stop offset="0.5" stopColor="#8b5cf6" />
                  <stop offset="1" stopColor="#06b6d4" />
                </linearGradient>
              </defs>
              <motion.circle cx="24" cy="24" r="22" fill="none" stroke="url(#btt-grad)" strokeWidth="2" strokeLinecap="round" style={{ pathLength: progress }} />
            </svg>
            <ArrowUp className="size-4 transition-transform duration-300 group-hover:-translate-y-0.5" aria-hidden />
          </motion.button>
        )}
      </AnimatePresence>
    </>
  );
}
