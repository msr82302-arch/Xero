"use client";

import Link from "next/link";
import { motion } from "motion/react";
import { ArrowRight } from "lucide-react";
import type { ComponentProps, ReactNode } from "react";
import { useMagnetic } from "@/hooks/use-magnetic";
import { cn } from "@/lib/utils";

type Variant = "primary" | "secondary" | "ghost" | "outline";
type Size = "sm" | "md" | "lg";

const base =
  "group relative inline-flex items-center justify-center gap-2 rounded-full font-medium whitespace-nowrap transition-[background-color,border-color,color,box-shadow] duration-300 disabled:pointer-events-none disabled:opacity-50 select-none";

const variants: Record<Variant, string> = {
  primary:
    "bg-white text-ink-950 shadow-[0_0_0_1px_rgba(255,255,255,0.1),0_8px_30px_-6px_rgba(139,92,246,0.55)] hover:shadow-[0_0_0_1px_rgba(255,255,255,0.2),0_10px_40px_-4px_rgba(139,92,246,0.8)]",
  secondary: "glass text-fg hover:bg-white/10 hover:border-white/20",
  outline: "border border-line-strong text-fg hover:border-white/40 hover:bg-white/5",
  ghost: "text-muted hover:text-fg",
};

const sizes: Record<Size, string> = {
  sm: "h-9 px-4 text-sm",
  md: "h-11 px-6 text-sm",
  lg: "h-13 px-7 text-[0.95rem] sm:h-14 sm:px-8",
};

interface CommonProps {
  variant?: Variant;
  size?: Size;
  magnetic?: boolean;
  arrow?: boolean;
  className?: string;
  children: ReactNode;
}

type ButtonAsLink = CommonProps & { href: string } & Omit<ComponentProps<typeof Link>, "href" | "className" | "children">;
type ButtonAsButton = CommonProps & { href?: undefined } & Omit<ComponentProps<"button">, "className" | "children">;

export function Button(props: ButtonAsLink | ButtonAsButton) {
  const { variant = "primary", size = "md", magnetic = false, arrow = false, className, children, ...rest } = props;
  const mag = useMagnetic(0.22);
  const classes = cn(base, variants[variant], sizes[size], className);

  const content = (
    <>
      <span className="relative z-10 inline-flex items-center gap-2">{children}</span>
      {arrow && (
        <ArrowRight aria-hidden className="relative z-10 size-4 transition-transform duration-300 group-hover:translate-x-0.5" />
      )}
    </>
  );

  const inner =
    "href" in rest && rest.href !== undefined ? (
      <Link {...(rest as Omit<ButtonAsLink, keyof CommonProps>)} className={classes}>
        {content}
      </Link>
    ) : (
      <button {...(rest as Omit<ButtonAsButton, keyof CommonProps>)} className={classes}>
        {content}
      </button>
    );

  if (!magnetic) return inner;
  return (
    <motion.span className="flex [&>*]:flex-1" style={mag.style} onPointerMove={mag.onPointerMove} onPointerLeave={mag.onPointerLeave}>
      {inner}
    </motion.span>
  );
}
</file>

