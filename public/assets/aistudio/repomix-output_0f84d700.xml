<file path="frontend/src/components/effects/cookie-notice.tsx">
"use client";

import Link from "next/link";
import { AnimatePresence, motion } from "motion/react";
import { Cookie } from "lucide-react";
import { useEffect, useState } from "react";

const KEY = "cookie-consent";

/**
 * Lightweight consent notice. The site itself only uses essential storage and cookieless Vercel Analytics,
 * so this records the visitor's choice for any optional tools you add later (read it via localStorage[KEY]).
 */
export function CookieNotice() {
  const [open, setOpen] = useState(false);

  useEffect(() => {
    try {
      if (!localStorage.getItem(KEY)) {
        const t = setTimeout(() => setOpen(true), 2500);
        return () => clearTimeout(t);
      }
    } catch {
      /* storage unavailable — don't nag */
    }
  }, []);

  const choose = (value: "accepted" | "essential") => {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      /* ignore */
    }
    setOpen(false);
  };

  return (
    <AnimatePresence>
      {open && (
        <motion.div
          role="region"
          aria-label="Cookie preferences"
          initial={{ opacity: 0, y: 30 }}
          animate={{ opacity: 1, y: 0 }}
          exit={{ opacity: 0, y: 30 }}
          transition={{ duration: 0.45, ease: [0.16, 1, 0.3, 1] }}
          className="fixed inset-x-4 bottom-4 z-[65] sm:right-auto sm:left-6 sm:max-w-sm"
        >
          <div className="glass rounded-2xl bg-ink-900/90 p-5 shadow-2xl shadow-black/15">
            <div className="flex items-start gap-3">
              <span className="grid size-9 shrink-0 place-items-center rounded-xl bg-violet/15 text-violet">
                <Cookie className="size-4" aria-hidden />
              </span>
              <p className="text-sm leading-relaxed text-muted">
                We use essential storage and privacy-friendly analytics to improve this site. See our{" "}
                <Link href="/cookie-policy" className="text-fg underline underline-offset-2">
                  Cookie Policy
                </Link>
                .
              </p>
            </div>
            <div className="mt-4 flex gap-2">
              <button type="button" onClick={() => choose("accepted")} className="flex-1 rounded-full bg-white px-4 py-2 text-sm font-medium text-ink-950 transition hover:opacity-90">
                Accept
              </button>
              <button type="button" onClick={() => choose("essential")} className="flex-1 rounded-full border border-line px-4 py-2 text-sm text-fg transition hover:bg-white/5">
                Essential only
              </button>
            </div>
          </div>
        </motion.div>
      )}
    </AnimatePresence>
  );
}
