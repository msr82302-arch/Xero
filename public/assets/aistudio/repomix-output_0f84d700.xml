}

export const dynamicParams = false;

export async function generateMetadata({ params }: PageProps<"/services/[slug]">): Promise<Metadata> {
  const { slug } = await params;
  const service = getService(slug);
  if (!service) return {};
  return buildMetadata({ title: service.seo.title, description: service.seo.description, path: `/services/${slug}`, keywords: service.seo.keywords });
}

export default async function ServicePage({ params }: PageProps<"/services/[slug]">) {
  const { slug } = await params;
  const service = getService(slug);
  if (!service) notFound();

  const tiers = pricing.find((p) => p.id === pricingFor[service.slug])!;
  const work = caseStudies.filter((c) => workFor[service.slug].includes(c.category)).slice(0, 3);
  const related = getServicesBySlugs(service.related);
  const bookingHref = `/book-consultation?service=${encodeURIComponent(bookingServiceFor[service.slug])}`;

  return (
    <>
      <JsonLd data={serviceSchema(service)} />
      <PageHero
        eyebrow={service.name}
        title={service.tagline}
        description={service.description}
        breadcrumbs={[
          { name: "Services", path: "/services" },
          { name: service.name, path: `/services/${service.slug}` },
        ]}
        media={{ type: "image", src: service.image, alt: `${service.name} — illustrative photo` }}
      >
        <div className="flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href={bookingHref} size="lg" arrow magnetic>
            Book a Consultation
          </Button>
          <Button href="#offerings" size="lg" variant="secondary">
            Explore {service.shortName} Services
          </Button>
          <p className="text-sm text-muted sm:ml-3">
            From <span className="font-semibold text-fg">{service.startingPrice}</span>
          </p>
        </div>
      </PageHero>

      <Section className="pt-0 sm:pt-0" aria-labelledby="overview-title">
        <Container className="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
          <Reveal>
            <h2 id="overview-title" className="text-2xl font-semibold sm:text-3xl">
              Overview
            </h2>
            {service.intro.map((p) => (
              <p key={p.slice(0, 24)} className="mt-5 text-lg leading-relaxed text-muted">
                {p}
              </p>
            ))}
          </Reveal>
          <Reveal delay={0.1}>
            <div className="glass rounded-[var(--radius-card)] p-6 sm:p-8">
              <h3 className="font-semibold">What you can expect</h3>
              <ul className="mt-5 space-y-4">
                {service.outcomes.map((o) => (
                  <li key={o} className="flex gap-3 text-sm text-fg/85">
                    <CheckCircle2 className="size-5 shrink-0 text-mint" aria-hidden />
                    {o}
                  </li>
                ))}
              </ul>
              <div className="mt-8 border-t border-line pt-6">
                <p className="text-xs tracking-wide text-subtle uppercase">Technologies</p>
                <ul className="mt-3 flex flex-wrap gap-2">
                  {service.technologies.map((t) => (
                    <li key={t} className="rounded-full border border-line px-3 py-1 text-xs text-muted">
                      {t}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </Reveal>
        </Container>
      </Section>

      <Section id="offerings" aria-labelledby="offerings-title">
        <Container>
          <SectionHeading id="offerings-title" eyebrow="Capabilities" title={`${service.shortName} services we offer`} description="Engage us for a single capability or combine them into one program." />
          <ul className="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {service.offerings.map((o, i) => (
              <Reveal as="li" key={o.name} delay={(i % 3) * 0.06}>
                <SpotlightCard className="h-full p-6">
                  <span className="font-display text-xs text-subtle">{String(i + 1).padStart(2, "0")}</span>
                  <h3 className="mt-3 text-lg font-semibold">{o.name}</h3>
                  <p className="mt-2 text-sm text-muted">{o.description}</p>
                </SpotlightCard>
              </Reveal>
            ))}
          </ul>
        </Container>
      </Section>

      {work.length > 0 && (
        <Section aria-labelledby="svc-work-title">
          <Container>
            <SectionHeading id="svc-work-title" eyebrow="Work" title="Sample engagements" description="Illustrative projects showing how we approach this practice." />
            <ul className="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {work.map((w) => (
                <li key={w.slug}>
                  <CaseStudyCard study={w} />
                </li>
              ))}
            </ul>
          </Container>
        </Section>
      )}

      <Section aria-labelledby="svc-pricing-title">
        <Container>
          <SectionHeading id="svc-pricing-title" eyebrow="Pricing" title={`${tiers.label} pricing`} description="Indicative starting points. Every proposal is tailored after a free consultation." align="center" />
          <ul className="mt-12 grid gap-5 pt-3 sm:grid-cols-2 xl:grid-cols-4">
            {tiers.tiers.map((t) => (
              <li key={t.name}>
                <PricingCard tier={t} category={bookingServiceFor[service.slug]} />
              </li>
            ))}
          </ul>
        </Container>
      </Section>

      <FAQSection faqs={service.faqs} title={`${service.shortName} FAQs`} />

      <Section aria-labelledby="related-title">
        <Container>
          <SectionHeading id="related-title" eyebrow="Related services" title="Often combined with" />
          <ul className="mt-12 grid gap-4 md:grid-cols-3">
            {related.map((r) => (
              <li key={r.slug}>
                <ServiceCard service={r} />
              </li>
            ))}
          </ul>
        </Container>
      </Section>

      <CTASection title={`Let's talk about your ${service.shortName} goals.`} primary={{ label: "Book a Consultation", href: bookingHref }} secondary={{ label: "Request a Quote", href: "/contact?subject=Quote%20request" }} />
    </>
  );
}
</file>

