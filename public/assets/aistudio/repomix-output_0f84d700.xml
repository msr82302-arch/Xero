<file path="frontend/src/components/layout/mobile-nav.tsx">
"use client";

import Link from "next/link";
import { AnimatePresence, motion } from "motion/react";
import { ChevronDown, X } from "lucide-react";
import { useEffect, useRef, useState } from "react";
import { mainNav } from "@/data/navigation";
import { siteConfig } from "@/data/site";
import { setScrollLocked } from "@/lib/smooth-scroll";
import { cn } from "@/lib/utils";
import { Button } from "@/components/ui/button";
import { ThemeToggle } from "@/components/ui/theme-toggle";
import { Logo } from "@/components/visuals/logo";
import { SocialIcons } from "@/components/visuals/social-icons";

export function MobileNav({ open, onClose }: { open: boolean; onClose: () => void }) {
  const [expanded, setExpanded] = useState<string | null>(null);
  const panelRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (!open) return;
    setScrollLocked(true);
    const closeBtn = panelRef.current?.querySelector<HTMLButtonElement>("[data-close]");
    closeBtn?.focus();
    const onKey = (e: KeyboardEvent) => e.key === "Escape" && onClose();
    document.addEventListener("keydown", onKey);
    return () => {
      setScrollLocked(false);
      document.removeEventListener("keydown", onKey);
    };
  }, [open, onClose]);

  return (
    <AnimatePresence>
      {open && (
        <div className="fixed inset-0 z-[60] lg:hidden">
          <motion.div
            className="absolute inset-0 bg-ink-950/70 backdrop-blur-sm"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            onClick={onClose}
            aria-hidden
          />
          <motion.div
            id="mobile-nav"
            ref={panelRef}
            role="dialog"
            aria-modal="true"
            aria-label="Site navigation"
            data-lenis-prevent
            initial={{ x: "100%" }}
            animate={{ x: 0 }}
            exit={{ x: "100%" }}
            transition={{ type: "spring", stiffness: 320, damping: 34 }}
            className="absolute inset-y-0 right-0 flex w-full max-w-md flex-col overflow-hidden border-l border-line bg-ink-900"
          >
            <div className="pointer-events-none absolute -top-32 -right-24 size-80 rounded-full bg-violet/25 blur-3xl" aria-hidden />
            <div className="relative flex h-16 items-center justify-between px-5">
              <Logo />
              <div className="flex items-center gap-2">
                <ThemeToggle />
                <button data-close type="button" onClick={onClose} aria-label="Close menu" className="grid size-10 place-items-center rounded-full border border-line">
                  <X className="size-5" />
                </button>
              </div>
            </div>

            <nav aria-label="Mobile" className="relative flex-1 overflow-y-auto px-5 pt-4 pb-8">
              <ul className="space-y-1">
                {mainNav.map((item, i) => (
                  <motion.li
                    key={item.label}
                    initial={{ opacity: 0, x: 24 }}
                    animate={{ opacity: 1, x: 0 }}
                    transition={{ delay: 0.05 + i * 0.04, duration: 0.4, ease: [0.16, 1, 0.3, 1] }}
                    className="border-b border-line"
                  >
                    {item.children ? (
                      <>
                        <button
                          type="button"
                          aria-expanded={expanded === item.label}
                          onClick={() => setExpanded(expanded === item.label ? null : item.label)}
                          className="flex w-full items-center justify-between py-4 font-display text-2xl font-medium"
                        >
                          {item.label}
                          <ChevronDown className={cn("size-5 text-muted transition-transform", expanded === item.label && "rotate-180")} aria-hidden />
                        </button>
                        <AnimatePresence initial={false}>
                          {expanded === item.label && (
                            <motion.ul
                              initial={{ height: 0, opacity: 0 }}
                              animate={{ height: "auto", opacity: 1 }}
                              exit={{ height: 0, opacity: 0 }}
                              className="overflow-hidden"
                            >
                              {item.children.map((child) => {
                                const Icon = child.icon;
                                return (
                                  <li key={child.href + child.label}>
                                    <Link href={child.href} onClick={onClose} className="flex items-center gap-3 rounded-xl px-2 py-2.5 text-muted transition hover:bg-white/5 hover:text-fg">
                                      {Icon && <Icon className="size-4" aria-hidden />}
                                      <span className="text-[0.95rem]">{child.label}</span>
                                    </Link>
                                  </li>
                                );
                              })}
                              <li className="pb-3" />
                            </motion.ul>
                          )}
                        </AnimatePresence>
                      </>
                    ) : (
                      <Link href={item.href} onClick={onClose} className="block py-4 font-display text-2xl font-medium">
                        {item.label}
                      </Link>
                    )}
                  </motion.li>
                ))}
                <li className="border-b border-line">
                  <Link href="/contact" onClick={onClose} className="block py-4 font-display text-2xl font-medium">
                    Contact
                  </Link>
                </li>
              </ul>
            </nav>

            <div className="relative space-y-5 border-t border-line p-5">
              <Button href="/book-consultation" size="lg" arrow className="w-full" onClick={onClose}>
                Book a Consultation
              </Button>
              <div className="flex flex-wrap items-center justify-between gap-4">
                <a href={`mailto:${siteConfig.contact.email}`} className="text-sm text-muted">
                  {siteConfig.contact.email}
                </a>
                <SocialIcons className="gap-1.5" />
              </div>
            </div>
          </motion.div>
        </div>
      )}
    </AnimatePresence>
  );
}
