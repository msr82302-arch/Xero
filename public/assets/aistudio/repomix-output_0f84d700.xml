export const getAuthor = (id: string) => authors.find((a) => a.id === id) ?? authors[0];
export const getRelatedPosts = (post: BlogPost, count = 3) =>
  [...posts.filter((p) => p.slug !== post.slug && p.category === post.category), ...posts.filter((p) => p.slug !== post.slug && p.category !== post.category)].slice(0, count);

