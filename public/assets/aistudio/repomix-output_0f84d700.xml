<file path="frontend/src/components/forms/booking-calendar.tsx">
"use client";

import { ChevronLeft, ChevronRight, Loader2 } from "lucide-react";
import { useEffect, useMemo, useState } from "react";
import { cn, formatDate, formatTime12h } from "@/lib/utils";
import { api } from "@/services/api";

interface BookingCalendarProps {
  date: string;
  time: string;
  onDateChange: (date: string) => void;
  onTimeChange: (time: string) => void;
  dateError?: string;
  timeError?: string;
}

const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

function monthKey(iso: string) {
  return iso.slice(0, 7);
}

function daysInMonth(ym: string) {
  const [y, m] = ym.split("-").map(Number);
  return new Date(Date.UTC(y, m, 0)).getUTCDate();
}

function shiftMonth(ym: string, delta: number) {
  const [y, m] = ym.split("-").map(Number);
  const d = new Date(Date.UTC(y, m - 1 + delta, 1));
  return d.toISOString().slice(0, 7);
}

export function BookingCalendar({ date, time, onDateChange, onTimeChange, dateError, timeError }: BookingCalendarProps) {
  const [available, setAvailable] = useState<Map<string, number> | null>(null);
  const [timezone, setTimezone] = useState("");
  const [month, setMonth] = useState<string | null>(null);
  const [slots, setSlots] = useState<string[] | null>(null);
  const [loadingSlots, setLoadingSlots] = useState(false);
  const [loadError, setLoadError] = useState<string | null>(null);

  useEffect(() => {
    api.getAvailability().then((res) => {
      if (!res.ok || !res.data?.dates) {
        setLoadError(res.error ?? "Couldn't load availability.");
        return;
      }
      const map = new Map(res.data.dates.map((d) => [d.date, d.slots]));
      setAvailable(map);
      setTimezone(res.data.timezone);
      const firstOpen = res.data.dates.find((d) => d.slots > 0)?.date ?? res.data.dates[0].date;
      setMonth(monthKey(date || firstOpen));
    });
    // Load once on mount; `date` only seeds the initial month.
  }, []);

  useEffect(() => {
    if (!date) return;
    let cancelled = false;
    setLoadingSlots(true);
    api.getAvailability(date).then((res) => {
      if (cancelled) return;
      setSlots(res.ok ? (res.data?.slots ?? []) : []);
      setLoadingSlots(false);
    });
    return () => {
      cancelled = true;
    };
  }, [date]);

  const bounds = useMemo(() => {
    if (!available) return null;
    const keys = [...available.keys()];
    return { first: monthKey(keys[0]), last: monthKey(keys[keys.length - 1]) };
  }, [available]);

  if (loadError) return <p className="text-sm text-rose-600 dark:text-rose-300">{loadError}</p>;
  if (!available || !month || !bounds) {
    return (
      <div className="grid h-80 place-items-center rounded-2xl border border-line">
        <Loader2 className="size-5 animate-spin text-muted" aria-label="Loading availability" />
      </div>
    );
  }

  const [y, m] = month.split("-").map(Number);
  const leading = new Date(Date.UTC(y, m - 1, 1)).getUTCDay();
  const total = daysInMonth(month);
  const cells = [...Array(leading).fill(null), ...Array.from({ length: total }, (_, i) => `${month}-${String(i + 1).padStart(2, "0")}`)];
  const monthLabel = new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(Date.UTC(y, m - 1, 1)));

  return (
    <div className="grid gap-6 lg:grid-cols-[1.2fr_1fr]">
      <fieldset className="rounded-2xl border border-line bg-white/[0.02] p-4 sm:p-5">
        <legend className="sr-only">Preferred date</legend>
        <div className="mb-4 flex items-center justify-between">
          <p className="font-display font-semibold" aria-live="polite">
            {monthLabel}
          </p>
          <div className="flex gap-1">
            <button type="button" aria-label="Previous month" disabled={month <= bounds.first} onClick={() => setMonth(shiftMonth(month, -1))} className="grid size-9 place-items-center rounded-full border border-line transition hover:bg-white/5 disabled:opacity-30">
              <ChevronLeft className="size-4" />
            </button>
            <button type="button" aria-label="Next month" disabled={month >= bounds.last} onClick={() => setMonth(shiftMonth(month, 1))} className="grid size-9 place-items-center rounded-full border border-line transition hover:bg-white/5 disabled:opacity-30">
              <ChevronRight className="size-4" />
            </button>
          </div>
        </div>
        <div className="grid grid-cols-7 gap-1 text-center text-[0.7rem] text-subtle" aria-hidden>
          {WEEKDAYS.map((d) => (
            <span key={d} className="py-1">
              {d}
            </span>
          ))}
        </div>
        <div className="mt-1 grid grid-cols-7 gap-1">
          {cells.map((iso, i) => {
            if (!iso) return <span key={`empty-${i}`} />;
            const open = (available.get(iso) ?? 0) > 0;
            const selected = iso === date;
            return (
              <button
                key={iso}
                type="button"
                disabled={!open}
                aria-pressed={selected}
                aria-label={`${formatDate(iso, { weekday: "long", month: "long", day: "numeric" })}${open ? "" : " (unavailable)"}`}
                onClick={() => {
                  onDateChange(iso);
                  onTimeChange("");
                }}
                className={cn(
                  "relative aspect-square rounded-xl text-sm transition-all duration-200",
                  selected
                    ? "bg-white font-semibold text-ink-950 shadow-[0_0_24px_rgba(167,139,250,0.5)]"
                    : open
                      ? "text-fg hover:bg-white/10"
                      : "cursor-not-allowed text-white/20",
                )}
              >
                {Number(iso.slice(8))}
                {open && !selected && <span className="absolute bottom-1.5 left-1/2 size-1 -translate-x-1/2 rounded-full bg-cyan" aria-hidden />}
              </button>
            );
          })}
        </div>
        {dateError && <p role="alert" className="mt-3 text-sm text-rose-600 dark:text-rose-300">{dateError}</p>}
      </fieldset>

      <fieldset className="rounded-2xl border border-line bg-white/[0.02] p-4 sm:p-5">
        <legend className="sr-only">Available time</legend>
        <p className="font-display font-semibold">{date ? formatDate(date, { weekday: "long", month: "long", day: "numeric" }) : "Select a date"}</p>
        <p className="mt-1 text-xs text-subtle">Times shown in {timezone.replace("_", " ")} · 30 minutes</p>
        <div className="mt-4">
          {!date ? (
            <p className="text-sm text-muted">Choose a date to see available times.</p>
          ) : loadingSlots ? (
            <Loader2 className="size-5 animate-spin text-muted" aria-label="Loading times" />
          ) : slots && slots.length > 0 ? (
            <div data-lenis-prevent className="grid max-h-72 grid-cols-2 gap-2 overflow-y-auto pr-1 sm:grid-cols-3 lg:grid-cols-2" role="radiogroup" aria-label="Available times">
              {slots.map((s) => (
                <button
                  key={s}
                  type="button"
                  role="radio"
                  aria-checked={s === time}
                  onClick={() => onTimeChange(s)}
                  className={cn(
                    "rounded-xl border px-3 py-2.5 text-sm transition-all",
                    s === time ? "border-transparent bg-accent-gradient font-medium text-snow" : "border-line text-fg hover:border-white/30",
                  )}
                >
                  {formatTime12h(s)}
                </button>
              ))}
            </div>
          ) : (
            <p className="text-sm text-muted">No times left on this day — please pick another date.</p>
          )}
        </div>
        {timeError && <p role="alert" className="mt-3 text-sm text-rose-600 dark:text-rose-300">{timeError}</p>}
      </fieldset>
    </div>
  );
}
</file>

<file path="frontend/src/components/forms/booking-form.tsx">
"use client";

import Link from "next/link";
import { useSearchParams } from "next/navigation";
import { AnimatePresence, motion } from "motion/react";
import { ArrowLeft, ArrowRight, CalendarCheck, Check, Loader2, Mail } from "lucide-react";
import { useRef, useState, type FormEvent } from "react";
import { bookingServices, budgetRanges, projectTypes, type BookingService } from "@/data/booking";
import { cn, formatDate, formatTime12h } from "@/lib/utils";
import { bookingSchema, fieldErrors, type BookingInput } from "@/lib/validation";
import { api } from "@/services/api";
import { Field, Honeypot, Input, Select, Textarea } from "@/components/ui/form-field";
import { Button } from "@/components/ui/button";
import { BookingCalendar } from "./booking-calendar";

type FormState = Omit<BookingInput, "service" | "projectType" | "budget" | "consent"> & {
  service: BookingService | "";
  projectType: BookingInput["projectType"] | "";
  budget: BookingInput["budget"] | "";
  consent: boolean;
};

const steps = [
  { title: "Project", fields: ["service", "projectType"] },
  { title: "Date & time", fields: ["date", "time"] },
  { title: "Your details", fields: ["name", "email", "phone", "company", "budget", "requirements", "consent"] },
  { title: "Review", fields: [] },
] as const;

export function BookingForm() {
  const params = useSearchParams();
  const initialService = params.get("service");
  const [step, setStep] = useState(0);
  const [direction, setDirection] = useState(1);
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [submitting, setSubmitting] = useState(false);
  const [submitError, setSubmitError] = useState<string | null>(null);
  const [confirmation, setConfirmation] = useState<{ id: string; date: string; time: string } | null>(null);
  const topRef = useRef<HTMLDivElement>(null);
  /** Guards against a double-click on "Continue" immediately submitting the review step. */
  const stepChangedAt = useRef(0);

  const [form, setForm] = useState<FormState>({
    service: (bookingServices as readonly string[]).includes(initialService ?? "") ? (initialService as BookingService) : "",
    projectType: "",
    date: "",
    time: "",
    name: "",
    email: "",
    phone: "",
    company: "",
    budget: "",
    requirements: "",
    consent: false,
    website: "",
  });

  const set = <K extends keyof FormState>(key: K, value: FormState[K]) => {
    setForm((f) => ({ ...f, [key]: value }));
    if (errors[key as string]) setErrors((e) => ({ ...e, [key as string]: "" }));
  };

  const validateStep = (index: number) => {
    const fields = steps[index].fields as readonly string[];
    if (!fields.length) return true;
    const result = bookingSchema.safeParse(form);
    if (result.success) return true;
    const all = fieldErrors(result.error);
    const relevant = Object.fromEntries(Object.entries(all).filter(([k]) => fields.includes(k)));
    setErrors(relevant);
    if (Object.keys(relevant).length) {
      const first = document.getElementById(`bk-${Object.keys(relevant)[0]}`);
      first?.focus();
      return false;
    }
    return true;
  };

  const go = (to: number) => {
    setDirection(to > step ? 1 : -1);
    setStep(to);
    stepChangedAt.current = Date.now();
    topRef.current?.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  const next = () => validateStep(step) && go(step + 1);

  const onSubmit = async (e: FormEvent) => {
    e.preventDefault();
    if (step < steps.length - 1) return next();
    if (Date.now() - stepChangedAt.current < 600) return;
    const parsed = bookingSchema.safeParse(form);
    if (!parsed.success) {
      const errs = fieldErrors(parsed.error);
      setErrors(errs);
      const firstStep = steps.findIndex((s) => (s.fields as readonly string[]).some((f) => errs[f]));
      if (firstStep >= 0) go(firstStep);
      return;
    }
    setSubmitting(true);
    setSubmitError(null);
    const res = await api.submitBooking(parsed.data);
    setSubmitting(false);
    if (res.ok && res.data) {
      setConfirmation(res.data);
      topRef.current?.scrollIntoView({ behavior: "smooth", block: "start" });
      return;
    }
    setSubmitError(res.error ?? "Something went wrong.");
    if (res.fieldErrors) {
      setErrors(res.fieldErrors);
      const firstStep = steps.findIndex((s) => (s.fields as readonly string[]).some((f) => res.fieldErrors?.[f]));
      if (firstStep >= 0) go(firstStep);
    }
  };

  if (confirmation) {
    return (
      <div ref={topRef}>
        <motion.div
          initial={{ opacity: 0, scale: 0.97 }}
          animate={{ opacity: 1, scale: 1 }}
          transition={{ duration: 0.6, ease: [0.16, 1, 0.3, 1] }}
          className="relative overflow-hidden rounded-[2rem] border border-line bg-ink-900/70 p-8 text-center sm:p-14"
          role="status"
          aria-live="polite"
        >
          <div className="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(52,211,153,0.18),transparent_60%)]" aria-hidden />
          <motion.div
            initial={{ scale: 0 }}
            animate={{ scale: 1 }}
            transition={{ type: "spring", stiffness: 260, damping: 18, delay: 0.15 }}
            className="relative mx-auto grid size-20 place-items-center rounded-full bg-gradient-to-br from-mint to-cyan shadow-[0_0_60px_rgba(52,211,153,0.45)]"
          >
            <Check className="size-9 text-ink-950" strokeWidth={3} aria-hidden />
          </motion.div>
          <h2 className="relative mt-8 text-3xl font-semibold sm:text-4xl">Your consultation is booked</h2>
          <p className="relative mx-auto mt-4 max-w-lg text-muted">
            Thanks, {form.name.split(" ")[0]}. We&apos;ve sent a confirmation to <span className="text-fg">{form.email}</span>. A senior consultant will review your details and send a meeting link before the call.
          </p>
          <dl className="relative mx-auto mt-10 grid max-w-xl gap-px overflow-hidden rounded-2xl border border-line bg-line text-left sm:grid-cols-3">
            <div className="bg-ink-900 p-4">
              <dt className="text-xs text-subtle">When</dt>
              <dd className="mt-1 text-sm font-medium">
                {formatDate(confirmation.date, { weekday: "short", month: "short", day: "numeric" })} · {formatTime12h(confirmation.time)}
              </dd>
            </div>
            <div className="bg-ink-900 p-4">
              <dt className="text-xs text-subtle">Service</dt>
              <dd className="mt-1 text-sm font-medium">{form.service}</dd>
            </div>
            <div className="bg-ink-900 p-4">
              <dt className="text-xs text-subtle">Reference</dt>
              <dd className="mt-1 font-mono text-sm font-medium">{confirmation.id.slice(0, 8).toUpperCase()}</dd>
            </div>
          </dl>
          <div className="relative mt-10 flex flex-col justify-center gap-3 sm:flex-row">
            <Button href="/work" variant="secondary">
              Explore our work
            </Button>
            <Button href="/blog" variant="ghost" arrow>
              Read our insights
            </Button>
          </div>
        </motion.div>
      </div>
    );
  }

  return (
    <div ref={topRef} className="scroll-mt-28">
      {/* Stepper */}
      <ol className="mb-8 grid grid-cols-4 gap-2" aria-label="Booking progress">
        {steps.map((s, i) => (
          <li key={s.title}>
            <button
              type="button"
              disabled={i > step}
              onClick={() => i < step && go(i)}
              aria-current={i === step ? "step" : undefined}
              className="w-full text-left disabled:cursor-default"
            >
              <span className="block h-1 overflow-hidden rounded-full bg-line">
                <motion.span className="block h-full bg-accent-gradient" initial={false} animate={{ width: i <= step ? "100%" : "0%" }} transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }} />
              </span>
              <span className={cn("mt-2 block text-xs sm:text-sm", i === step ? "text-fg" : "text-subtle")}>
                <span className="hidden sm:inline">{String(i + 1).padStart(2, "0")} · </span>
                {s.title}
              </span>
            </button>
          </li>
        ))}
      </ol>

      <form onSubmit={onSubmit} noValidate className="relative overflow-hidden rounded-[2rem] border border-line bg-ink-900/60 p-5 sm:p-8 lg:p-10">
        <Honeypot value={form.website ?? ""} onChange={(v) => set("website", v)} />
        <AnimatePresence mode="wait" custom={direction} initial={false}>
          <motion.div
            key={step}
            custom={direction}
            initial={{ opacity: 0, x: direction * 40 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: direction * -40 }}
            transition={{ duration: 0.35, ease: [0.16, 1, 0.3, 1] }}
          >
            {step === 0 && (
              <div className="space-y-10">
                <fieldset>
                  <legend className="font-display text-xl font-semibold">Which service are you interested in?</legend>
                  <div id="bk-service" tabIndex={-1} className="mt-5 grid grid-cols-2 gap-2 outline-none sm:grid-cols-3 lg:grid-cols-4" role="radiogroup" aria-invalid={!!errors.service}>
                    {bookingServices.map((s) => (
                      <button
                        key={s}
                        type="button"
                        role="radio"
                        aria-checked={form.service === s}
                        onClick={() => set("service", s)}
                        className={cn(
                          "rounded-xl border px-4 py-3.5 text-left text-sm transition-all",
                          form.service === s ? "border-violet/70 bg-violet/15 text-fg shadow-[0_0_0_4px_rgba(139,92,246,0.12)]" : "border-line text-muted hover:border-white/25 hover:text-fg",
                        )}
                      >
                        {s}
                      </button>
                    ))}
                  </div>
                  {errors.service && <p role="alert" className="mt-3 text-sm text-rose-600 dark:text-rose-300">{errors.service}</p>}
                </fieldset>
                <fieldset>
                  <legend className="font-display text-xl font-semibold">What type of project is it?</legend>
                  <div id="bk-projectType" tabIndex={-1} className="mt-5 grid gap-2 outline-none sm:grid-cols-2 lg:grid-cols-3" role="radiogroup">
                    {projectTypes.map((p) => (
                      <button
                        key={p}
                        type="button"
                        role="radio"
                        aria-checked={form.projectType === p}
                        onClick={() => set("projectType", p)}
                        className={cn(
                          "flex items-center justify-between rounded-xl border px-4 py-3.5 text-left text-sm transition-all",
                          form.projectType === p ? "border-violet/70 bg-violet/15 text-fg" : "border-line text-muted hover:border-white/25 hover:text-fg",
                        )}
                      >
                        {p}
                        {form.projectType === p && <Check className="size-4 text-violet" aria-hidden />}
                      </button>
                    ))}
                  </div>
                  {errors.projectType && <p role="alert" className="mt-3 text-sm text-rose-600 dark:text-rose-300">{errors.projectType}</p>}
                </fieldset>
              </div>
            )}

            {step === 1 && (
              <div>
                <h2 className="font-display text-xl font-semibold">Pick a date and time</h2>
                <p className="mt-1 mb-6 text-sm text-muted">Free 30-minute video call with a senior consultant.</p>
                <div id="bk-date" tabIndex={-1} className="outline-none">
                  <BookingCalendar
                    date={form.date}
                    time={form.time}
                    onDateChange={(d) => set("date", d)}
                    onTimeChange={(t) => set("time", t)}
                    dateError={errors.date}
                    timeError={errors.time}
                  />
                </div>
              </div>
            )}

            {step === 2 && (
              <div>
                <h2 className="font-display text-xl font-semibold">Tell us about you and your project</h2>
                <div className="mt-6 grid gap-5 sm:grid-cols-2">
                  <Field id="bk-name" label="Full name" required error={errors.name}>
                    <Input id="bk-name" autoComplete="name" value={form.name} onChange={(e) => set("name", e.target.value)} aria-invalid={!!errors.name} aria-describedby={errors.name ? "bk-name-error" : undefined} />
                  </Field>
                  <Field id="bk-email" label="Work email" required error={errors.email}>
                    <Input id="bk-email" type="email" autoComplete="email" value={form.email} onChange={(e) => set("email", e.target.value)} aria-invalid={!!errors.email} aria-describedby={errors.email ? "bk-email-error" : undefined} />
                  </Field>
                  <Field id="bk-phone" label="Phone" required error={errors.phone}>
                    <Input id="bk-phone" type="tel" autoComplete="tel" value={form.phone} onChange={(e) => set("phone", e.target.value)} aria-invalid={!!errors.phone} aria-describedby={errors.phone ? "bk-phone-error" : undefined} />
                  </Field>
                  <Field id="bk-company" label="Company" hint="Optional" error={errors.company}>
                    <Input id="bk-company" autoComplete="organization" value={form.company ?? ""} onChange={(e) => set("company", e.target.value)} />
                  </Field>
                  <Field id="bk-budget" label="Project budget" required error={errors.budget} className="sm:col-span-2">
                    <Select id="bk-budget" value={form.budget} onChange={(e) => set("budget", e.target.value as FormState["budget"])} aria-invalid={!!errors.budget} aria-describedby={errors.budget ? "bk-budget-error" : undefined}>
                      <option value="">Select a range</option>
                      {budgetRanges.map((b) => (
                        <option key={b} value={b}>
                          {b}
                        </option>
                      ))}
                    </Select>
                  </Field>
                  <Field id="bk-requirements" label="Project requirements" required error={errors.requirements} hint={`${form.requirements.length}/4000 · goals, timeline, links, current setup`} className="sm:col-span-2">
                    <Textarea
                      id="bk-requirements"
                      rows={6}
                      value={form.requirements}
                      onChange={(e) => set("requirements", e.target.value)}
                      placeholder="What are you looking to build or improve? What does success look like?"
                      aria-invalid={!!errors.requirements}
                      aria-describedby={errors.requirements ? "bk-requirements-error" : "bk-requirements-hint"}
                    />
                  </Field>
                  <div className="sm:col-span-2">
                    <label className="flex cursor-pointer items-start gap-3 text-sm text-muted">
                      <input
                        id="bk-consent"
                        type="checkbox"
                        checked={form.consent}
                        onChange={(e) => set("consent", e.target.checked)}
                        className="mt-0.5 size-4 shrink-0 accent-violet-500"
                        aria-invalid={!!errors.consent}
                      />
                      <span>
                        I agree to be contacted about this booking and accept the{" "}
                        <Link href="/privacy-policy" className="text-fg underline underline-offset-2">
                          Privacy Policy
                        </Link>
                        .
                      </span>
                    </label>
                    {errors.consent && <p role="alert" className="mt-2 text-sm text-rose-600 dark:text-rose-300">{errors.consent}</p>}
                  </div>
                </div>
              </div>
            )}

            {step === 3 && (
              <div>
                <h2 className="font-display text-xl font-semibold">Review your booking</h2>
                <dl className="mt-6 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
                  {[
                    ["Service", form.service, 0],
                    ["Project type", form.projectType, 0],
                    ["Date", form.date ? formatDate(form.date, { weekday: "long", month: "long", day: "numeric", year: "numeric" }) : "", 1],
                    ["Time", form.time ? formatTime12h(form.time) : "", 1],
                    ["Name", form.name, 2],
                    ["Email", form.email, 2],
                    ["Phone", form.phone, 2],
                    ["Company", form.company || "—", 2],
                    ["Budget", form.budget, 2],
                  ].map(([label, value, s]) => (
                    <div key={label as string} className="flex items-start justify-between gap-4 bg-ink-900 p-4">
                      <div>
                        <dt className="text-xs text-subtle">{label}</dt>
                        <dd className="mt-1 text-sm font-medium">{value}</dd>
                      </div>
                      <button type="button" onClick={() => go(s as number)} className="text-xs text-muted underline-offset-2 hover:text-fg hover:underline">
                        Edit
                      </button>
                    </div>
                  ))}
                  <div className="bg-ink-900 p-4 sm:col-span-2">
                    <dt className="text-xs text-subtle">Requirements</dt>
                    <dd className="mt-1 text-sm whitespace-pre-wrap text-fg/85">{form.requirements}</dd>
                  </div>
                </dl>
                <p className="mt-5 flex items-center gap-2 text-xs text-subtle">
                  <Mail className="size-3.5" aria-hidden /> You&apos;ll receive a confirmation email immediately after booking.
                </p>
              </div>
            )}
          </motion.div>
        </AnimatePresence>

        {submitError && (
          <p role="alert" className="mt-6 rounded-xl border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-sm text-rose-700 dark:text-rose-200">
            {submitError}
          </p>
        )}

        <div className="mt-10 flex items-center justify-between gap-4 border-t border-line pt-6">
          {step > 0 ? (
            <button type="button" onClick={() => go(step - 1)} className="inline-flex items-center gap-2 text-sm text-muted transition hover:text-fg">
              <ArrowLeft className="size-4" aria-hidden /> Back
            </button>
          ) : (
            <span />
          )}
          {step < steps.length - 1 ? (
            <Button type="submit">
              Continue <ArrowRight className="size-4" aria-hidden />
            </Button>
          ) : (
            <Button type="submit" disabled={submitting}>
              {submitting ? <Loader2 className="size-4 animate-spin" aria-hidden /> : <CalendarCheck className="size-4" aria-hidden />}
              {submitting ? "Booking…" : "Confirm Booking"}
            </Button>
          )}
        </div>
      </form>
    </div>
  );
}
</file>

<file path="frontend/src/components/forms/contact-form.tsx">
"use client";

import { useSearchParams } from "next/navigation";
import { AnimatePresence, motion } from "motion/react";
import { Check, Loader2, Send } from "lucide-react";
import { useState, type FormEvent } from "react";
import { contactSchema, fieldErrors, type ContactInput } from "@/lib/validation";
import { api } from "@/services/api";
import { Field, Honeypot, Input, Textarea } from "@/components/ui/form-field";
import { Button } from "@/components/ui/button";

export function ContactForm() {
  const params = useSearchParams();
  const [form, setForm] = useState<ContactInput>({
    name: "",
    email: "",
    company: "",
    subject: params.get("subject") ?? "",
    message: "",
    website: "",
  });
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [status, setStatus] = useState<"idle" | "loading" | "success">("idle");
  const [submitError, setSubmitError] = useState<string | null>(null);

  const set = (key: keyof ContactInput, value: string) => {
    setForm((f) => ({ ...f, [key]: value }));
    if (errors[key]) setErrors((e) => ({ ...e, [key]: "" }));
  };

  const onSubmit = async (e: FormEvent) => {
    e.preventDefault();
    const parsed = contactSchema.safeParse(form);
    if (!parsed.success) {
      const errs = fieldErrors(parsed.error);
      setErrors(errs);
      document.getElementById(`ct-${Object.keys(errs)[0]}`)?.focus();
      return;
    }
    setStatus("loading");
    setSubmitError(null);
    const res = await api.submitContact(parsed.data);
    if (res.ok) {
      setStatus("success");
      return;
    }
    setStatus("idle");
    setSubmitError(res.error ?? "Something went wrong.");
    if (res.fieldErrors) setErrors(res.fieldErrors);
  };

  return (
    <AnimatePresence mode="wait">
      {status === "success" ? (
        <motion.div key="ok" initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} className="rounded-[2rem] border border-line bg-ink-900/60 p-10 text-center" role="status">
          <span className="mx-auto grid size-16 place-items-center rounded-full bg-gradient-to-br from-mint to-cyan">
            <Check className="size-7 text-ink-950" strokeWidth={3} aria-hidden />
          </span>
          <h2 className="mt-6 text-2xl font-semibold">Message received</h2>
          <p className="mx-auto mt-3 max-w-md text-muted">Thanks, {form.name.split(" ")[0]}. We&apos;ll get back to you within one business day. A copy has been sent to {form.email}.</p>
          <div className="mt-8">
            <Button href="/book-consultation" arrow>
              Book a Consultation
            </Button>
          </div>
        </motion.div>
      ) : (
        <motion.form key="form" onSubmit={onSubmit} noValidate className="relative grid content-start gap-5 self-start rounded-[2rem] border border-line bg-ink-900/60 p-6 sm:grid-cols-2 sm:p-8" exit={{ opacity: 0, y: -10 }}>
          <Honeypot value={form.website ?? ""} onChange={(v) => set("website", v)} />
          <Field id="ct-name" label="Name" required error={errors.name}>
            <Input id="ct-name" autoComplete="name" value={form.name} onChange={(e) => set("name", e.target.value)} aria-invalid={!!errors.name} />
          </Field>
          <Field id="ct-email" label="Email" required error={errors.email}>
            <Input id="ct-email" type="email" autoComplete="email" value={form.email} onChange={(e) => set("email", e.target.value)} aria-invalid={!!errors.email} />
          </Field>
          <Field id="ct-company" label="Company" hint="Optional">
            <Input id="ct-company" autoComplete="organization" value={form.company ?? ""} onChange={(e) => set("company", e.target.value)} />
          </Field>
          <Field id="ct-subject" label="Subject" required error={errors.subject}>
            <Input id="ct-subject" value={form.subject} onChange={(e) => set("subject", e.target.value)} aria-invalid={!!errors.subject} />
          </Field>
          <Field id="ct-message" label="Message" required error={errors.message} className="sm:col-span-2">
            <Textarea id="ct-message" rows={6} value={form.message} onChange={(e) => set("message", e.target.value)} aria-invalid={!!errors.message} placeholder="How can we help?" />
          </Field>
          {submitError && (
            <p role="alert" className="rounded-xl border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-sm text-rose-700 dark:text-rose-200 sm:col-span-2">
              {submitError}
            </p>
          )}
          <div className="flex flex-col items-start justify-between gap-4 sm:col-span-2 sm:flex-row sm:items-center">
            <p className="text-xs text-subtle">We reply within one business day.</p>
            <Button type="submit" disabled={status === "loading"}>
              {status === "loading" ? <Loader2 className="size-4 animate-spin" aria-hidden /> : <Send className="size-4" aria-hidden />}
              {status === "loading" ? "Sending…" : "Send Message"}
            </Button>
          </div>
        </motion.form>
      )}
    </AnimatePresence>
  );
}
</file>

<file path="frontend/src/components/forms/newsletter-form.tsx">
"use client";

import { ArrowRight, Check, Loader2 } from "lucide-react";
import { useState, type FormEvent } from "react";
import { api } from "@/services/api";
import { Honeypot } from "@/components/ui/form-field";

export function NewsletterForm() {
  const [email, setEmail] = useState("");
  const [website, setWebsite] = useState("");
  const [status, setStatus] = useState<"idle" | "loading" | "success" | "error">("idle");
  const [message, setMessage] = useState("");

  const onSubmit = async (e: FormEvent) => {
    e.preventDefault();
    // Lightweight check here (keeps the validation library out of every page); the API re-validates with zod.
    const value = email.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) {
      setStatus("error");
      setMessage("Please enter a valid email address");
      return;
    }
    setStatus("loading");
    const res = await api.subscribe({ email: value, website });
    if (res.ok) {
      setStatus("success");
      setMessage("You're subscribed. Welcome aboard!");
      setEmail("");
    } else {
      setStatus("error");
      setMessage(res.error ?? "Something went wrong.");
    }
  };

  return (
    <form onSubmit={onSubmit} noValidate className="relative">
      <Honeypot value={website} onChange={setWebsite} />
      <label htmlFor="newsletter-email" className="sr-only">
        Email address
      </label>
      <div className="flex items-center gap-2 rounded-full border border-line bg-white/[0.03] p-1.5 pl-5 transition focus-within:border-violet/60 focus-within:ring-4 focus-within:ring-violet/15">
        <input
          id="newsletter-email"
          type="email"
          autoComplete="email"
          placeholder="you@company.com"
          value={email}
          onChange={(e) => setEmail(e.target.value)}
          aria-invalid={status === "error"}
          aria-describedby="newsletter-status"
          className="min-w-0 flex-1 bg-transparent text-sm text-fg outline-none placeholder:text-subtle"
        />
        <button
          type="submit"
          disabled={status === "loading"}
          aria-label="Subscribe to newsletter"
          className="grid size-10 shrink-0 place-items-center rounded-full bg-white text-ink-950 transition hover:scale-105 disabled:opacity-60"
        >
          {status === "loading" ? <Loader2 className="size-4 animate-spin" /> : status === "success" ? <Check className="size-4" /> : <ArrowRight className="size-4" />}
        </button>
      </div>
      <p id="newsletter-status" aria-live="polite" className={status === "error" ? "mt-2 text-sm text-rose-600 dark:text-rose-300" : "mt-2 text-sm text-mint"}>
        {status === "success" || status === "error" ? message : ""}
      </p>
    </form>
  );
}
</file>

