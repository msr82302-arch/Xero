<file path="src/services/server/storage.ts">
import "server-only";
import { promises as fs } from "node:fs";
import path from "node:path";
import { randomUUID } from "node:crypto";

/**
 * Lead storage adapter.
 *
 * Default behaviour:
 *  - Development: appends JSON lines to `.data/<collection>.jsonl` so you can inspect submissions.
 *  - Production: logs a structured line (serverless filesystems are read-only).
 *
 * To connect a real backend, replace `persist()` with a database insert
 * (Postgres/Prisma, Supabase, Airtable, your CRM…) — callers don't need to change.
 */
export type Collection = "bookings" | "contacts" | "newsletter";

export interface StoredRecord<T> {
  id: string;
  createdAt: string;
  data: T;
}

/** Per-instance memory of booked slots so duplicates are rejected even before a database is connected. */
const memoryBookings = new Map<string, Set<string>>();

async function persist<T>(collection: Collection, record: StoredRecord<T>) {
  if (collection === "bookings") {
    const { date, time } = record.data as { date: string; time: string };
    if (!memoryBookings.has(date)) memoryBookings.set(date, new Set());
    memoryBookings.get(date)!.add(time);
  }
  if (process.env.NODE_ENV !== "production") {
    const dir = path.join(process.cwd(), ".data");
    await fs.mkdir(dir, { recursive: true });
    await fs.appendFile(path.join(dir, `${collection}.jsonl`), JSON.stringify(record) + "\n", "utf8");
    return;
  }
  console.info(`[storage:${collection}]`, JSON.stringify({ id: record.id, createdAt: record.createdAt }));
}

export async function saveRecord<T>(collection: Collection, data: T): Promise<StoredRecord<T>> {
  const record: StoredRecord<T> = { id: randomUUID(), createdAt: new Date().toISOString(), data };
  await persist(collection, record);
  return record;
}

/** Already-booked slots for a date (used by availability). Replace with a database query in production. */
export async function getBookedSlots(date: string): Promise<string[]> {
  const inMemory = [...(memoryBookings.get(date) ?? [])];
  if (process.env.NODE_ENV === "production") return inMemory;
  try {
    const file = await fs.readFile(path.join(process.cwd(), ".data", "bookings.jsonl"), "utf8");
    return file
      .split("\n")
      .filter(Boolean)
      .map((line) => JSON.parse(line) as StoredRecord<{ date: string; time: string }>)
      .filter((r) => r.data.date === date)
      .map((r) => r.data.time)
      .concat(inMemory);
  } catch {
    return inMemory;
  }
}
</file>

