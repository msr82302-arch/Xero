"use client";

import { motion, useReducedMotion, useScroll, useTransform } from "motion/react";
import { useRef } from "react";
import { media } from "@/data/media";
import { Button } from "@/components/ui/button";
import { Container } from "@/components/ui/container";
import { Eyebrow } from "@/components/ui/section-heading";
import { VideoPlayer } from "@/components/visuals/video-player";

/** Full-bleed video panel that expands as it scrolls into view. */
export function Showreel() {
  const ref = useRef<HTMLDivElement>(null);
  const reduce = useReducedMotion();
  const { scrollYProgress } = useScroll({ target: ref, offset: ["start end", "center center"] });
  const scale = useTransform(scrollYProgress, [0, 1], [reduce ? 1 : 0.86, 1]);
  const radius = useTransform(scrollYProgress, [0, 1], [reduce ? 32 : 56, 32]);
  const textY = useTransform(scrollYProgress, [0, 1], [reduce ? 0 : 60, 0]);

  return (
    <section className="relative py-20 sm:py-28" aria-labelledby="showreel-title">
      <Container>
        <motion.div ref={ref} style={{ scale, borderRadius: radius }} className="relative overflow-hidden border border-line shadow-2xl shadow-violet/10">
          <VideoPlayer src={media.video.team.src} poster={media.video.team.poster} label="Our team collaborating around a project table" className="aspect-[4/5] sm:aspect-[16/9] lg:aspect-[21/9]" />
          <div className="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent" aria-hidden />
          <motion.div style={{ y: textY }} className="theme-dark pointer-events-none absolute inset-x-0 bottom-0 p-6 sm:p-10 lg:p-14">
            <Eyebrow>Inside Nexvora</Eyebrow>
            <h2 id="showreel-title" className="mt-4 max-w-2xl text-3xl leading-tight font-semibold text-white sm:text-4xl lg:text-5xl">
              Strategy, design and engineering — under one roof.
            </h2>
            <div className="pointer-events-auto mt-6 flex flex-wrap items-center gap-3">
              <Button href="/work" arrow>
                See Our Work
              </Button>
              <Button href="/about" variant="secondary">
                Meet the Team
              </Button>
            </div>
          </motion.div>
        </motion.div>
      </Container>
    </section>
  );
}
