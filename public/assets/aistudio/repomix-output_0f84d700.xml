"use client";

import { motion, useScroll, useSpring } from "motion/react";
import { useRef } from "react";
import { processSteps } from "@/data/company";
import { Container, Section } from "@/components/ui/container";
import { SectionHeading } from "@/components/ui/section-heading";

export function Process() {
  const ref = useRef<HTMLOListElement>(null);
  const { scrollYProgress } = useScroll({ target: ref, offset: ["start 70%", "end 60%"] });
  const progress = useSpring(scrollYProgress, { stiffness: 120, damping: 30, mass: 0.3 });

  return (
    <Section id="process" aria-labelledby="process-title" className="bg-gradient-to-b from-transparent via-ink-900/50 to-transparent">
      <Container>
        <SectionHeading
          id="process-title"
          align="center"
          eyebrow="How we work"
          title={
            <>
              A transparent process, <span className="text-gradient-accent">from idea to scale.</span>
            </>
          }
          description="Eight clear stages, weekly demos and no surprises. You always know what's happening, what's next and why."
        />

        <ol ref={ref} className="relative mx-auto mt-16 max-w-4xl">
          {/* Track + animated progress */}
          <div className="absolute top-0 bottom-0 left-5 w-px bg-line md:left-1/2" aria-hidden />
          <motion.div className="absolute top-0 bottom-0 left-5 w-px origin-top bg-gradient-to-b from-electric via-violet to-cyan md:left-1/2" style={{ scaleY: progress }} aria-hidden />

          {processSteps.map((step, i) => {
            const left = i % 2 === 0;
            return (
              <li key={step.number} className="relative grid gap-4 pb-14 pl-16 last:pb-0 md:grid-cols-2 md:gap-16 md:pl-0">
                <motion.span
                  initial={{ scale: 0.6, opacity: 0 }}
                  whileInView={{ scale: 1, opacity: 1 }}
                  viewport={{ once: false, margin: "-30% 0px" }}
                  transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }}
                  className="absolute top-0 left-5 z-10 grid size-10 -translate-x-1/2 place-items-center rounded-full border border-violet/40 bg-ink-900 font-display text-xs font-semibold text-fg shadow-[0_0_24px_rgba(139,92,246,0.45)] md:left-1/2"
                  aria-hidden
                >
                  {step.number}
                </motion.span>
                <motion.div
                  initial={{ opacity: 0, y: 24 }}
                  whileInView={{ opacity: 1, y: 0 }}
                  viewport={{ once: false, margin: "-20% 0px" }}
                  transition={{ duration: 0.8, ease: [0.16, 1, 0.3, 1] }}
                  className={left ? "md:pr-4 md:text-right" : "md:col-start-2 md:pl-4"}
                >
                  <p className="text-xs tracking-[0.2em] text-subtle uppercase">Step {step.number}</p>
                  <h3 className="mt-2 text-2xl font-semibold">{step.title}</h3>
                  <p className="mt-3 text-muted">{step.description}</p>
                  <ul className={`mt-4 flex flex-wrap gap-2 ${left ? "md:justify-end" : ""}`}>
                    {step.deliverables.map((d) => (
                      <li key={d} className="rounded-full border border-line bg-white/[0.02] px-3 py-1 text-xs text-muted">
                        {d}
                      </li>
                    ))}
                  </ul>
                </motion.div>
              </li>
            );
          })}
        </ol>
      </Container>
    </Section>
  );
}
</file>

