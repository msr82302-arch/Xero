import { absoluteUrl } from "@/data/site";
import { articleSchema, buildMetadata } from "@/lib/seo";
import { formatDate } from "@/lib/utils";
import { Accordion } from "@/components/ui/accordion";
import { Breadcrumbs } from "@/components/ui/breadcrumbs";
import { Button } from "@/components/ui/button";
import { Container, Section } from "@/components/ui/container";
import { JsonLd } from "@/components/ui/json-ld";
import { Eyebrow } from "@/components/ui/section-heading";
import { ShareButtons } from "@/components/ui/share-buttons";
import { BlogCard } from "@/components/cards/blog-card";
import { Photo } from "@/components/visuals/photo";
import { faqSchema } from "@/lib/seo";

export function generateStaticParams() {
  return posts.map((p) => ({ slug: p.slug }));
}

export const dynamicParams = false;

export async function generateMetadata({ params }: PageProps<"/blog/[slug]">): Promise<Metadata> {
  const { slug } = await params;
  const post = getPost(slug);
  if (!post) return {};
  return buildMetadata({
    title: post.seoTitle,
    description: post.metaDescription,
    path: `/blog/${slug}`,
    keywords: post.keywords,
    type: "article",
    publishedTime: post.publishedAt,
    modifiedTime: post.updatedAt ?? post.publishedAt,
  });
}

function Block({ block }: { block: ArticleBlock }) {
  switch (block.type) {
    case "h2":
      return <h2 id={slugify(block.text)}>{block.text}</h2>;
    case "h3":
      return <h3>{block.text}</h3>;
    case "ul":
      return (
        <ul>
          {block.items.map((i) => (
            <li key={i}>{i}</li>
          ))}
        </ul>
      );
    case "quote":
      return <blockquote>{block.text}</blockquote>;
    default:
      return <p>{block.text}</p>;
  }
}

export default async function BlogPostPage({ params }: PageProps<"/blog/[slug]">) {
  const { slug } = await params;
  const post = getPost(slug);
  if (!post) notFound();

  const author = getAuthor(post.authorId);
  const toc = post.content.filter((b): b is Extract<ArticleBlock, { type: "h2" }> => b.type === "h2");
  const related = getRelatedPosts(post);
  const url = absoluteUrl(`/blog/${post.slug}`);

  return (
    <>
      <JsonLd data={articleSchema(post, author.name)} />
      {post.faqs.length > 0 && <JsonLd data={faqSchema(post.faqs)} />}

      <article>
        <header className="relative overflow-hidden pt-32 pb-12 sm:pt-40">
          <div className="grid-bg absolute inset-0" aria-hidden />
          <div className="pointer-events-none absolute -top-40 right-0 size-[30rem] rounded-full opacity-25 blur-[120px]" style={{ background: post.accent[0] }} aria-hidden />
          <Container className="relative max-w-4xl">
            <Breadcrumbs items={[{ name: "Insights", path: "/blog" }, { name: post.title, path: `/blog/${post.slug}` }]} />
            <div className="mt-8">
              <Eyebrow>{post.category}</Eyebrow>
            </div>
            <h1 className="mt-6 text-4xl leading-[1.08] font-semibold sm:text-5xl lg:text-6xl">{post.title}</h1>
            <p className="mt-6 text-lg text-muted sm:text-xl">{post.excerpt}</p>
            <div className="mt-8 flex flex-wrap items-center justify-between gap-6 border-t border-line pt-6">
              <div className="flex items-center gap-3">
                <span className="grid size-11 place-items-center rounded-full bg-accent-gradient text-sm font-semibold text-snow" aria-hidden>
                  {author.initials}
                </span>
                <div>
                  <p className="text-sm font-medium">{author.name}</p>
                  <p className="text-xs text-subtle">
                    <time dateTime={post.publishedAt}>{formatDate(post.publishedAt, { month: "long", day: "numeric", year: "numeric" })}</time> · {post.readingMinutes} min read
                  </p>
                </div>
              </div>
              <ShareButtons url={url} title={post.title} />
            </div>
          </Container>
        </header>

        <Container className="max-w-5xl">
          <Photo src={post.image} alt={`Featured image for ${post.title}`} sizes="(min-width: 1024px) 1024px, 100vw" priority zoom={false} className="relative aspect-[2/1] rounded-[2rem] border border-line" />
        </Container>

        <Container className="mt-14 grid max-w-6xl gap-12 lg:grid-cols-[220px_1fr]">
          <aside className="lg:sticky lg:top-28 lg:self-start">
            <nav aria-label="Table of contents" className="rounded-2xl border border-line bg-white/[0.02] p-5">
              <p className="text-xs font-semibold tracking-wide text-subtle uppercase">On this page</p>
              <ol className="mt-4 space-y-2.5 text-sm">
                {toc.map((h) => (
                  <li key={h.text}>
                    <a href={`#${slugify(h.text)}`} className="text-muted transition-colors hover:text-fg">
                      {h.text}
                    </a>
                  </li>
                ))}
                {post.faqs.length > 0 && (
                  <li>
                    <a href="#article-faq" className="text-muted transition-colors hover:text-fg">
                      FAQ
                    </a>
                  </li>
                )}
              </ol>
            </nav>
          </aside>

          <div className="min-w-0 max-w-3xl">
            <div className="prose-article">
              {post.content.map((block, i) => (
                <Block key={i} block={block} />
              ))}
            </div>

            {post.faqs.length > 0 && (
              <section id="article-faq" className="mt-14" aria-labelledby="article-faq-title">
                <h2 id="article-faq-title" className="mb-6 text-2xl font-semibold">
                  Frequently asked questions
                </h2>
                <Accordion items={post.faqs} defaultOpen={null} />
              </section>
            )}

            <div className="glass mt-14 rounded-2xl p-6 sm:p-8">
              <p className="font-display text-xl font-semibold">Want help applying this to your business?</p>
              <p className="mt-2 text-sm text-muted">Book a free 30-minute consultation with our team.</p>
              <Button href="/book-consultation" className="mt-5" arrow>
                Get a Free Consultation
              </Button>
            </div>

            <section className="mt-10 flex gap-5 rounded-2xl border border-line p-6" aria-label="About the author">
              <span className="grid size-14 shrink-0 place-items-center rounded-full bg-accent-gradient font-semibold text-snow" aria-hidden>
                {author.initials}
              </span>
              <div>
                <p className="text-xs text-subtle">Written by</p>
                <p className="font-semibold">{author.name}</p>
                <p className="text-xs text-muted">{author.role}</p>
                <p className="mt-3 text-sm leading-relaxed text-muted">{author.bio}</p>
              </div>
            </section>

            <div className="mt-8 flex items-center justify-between gap-4 border-t border-line pt-6">
              <p className="text-sm text-subtle">Share this article</p>
              <ShareButtons url={url} title={post.title} />
            </div>
          </div>
        </Container>
      </article>

      <Section aria-labelledby="related-posts-title">
        <Container>
          <h2 id="related-posts-title" className="text-2xl font-semibold sm:text-3xl">
            Related articles
          </h2>
          <ul className="mt-10 grid gap-5 md:grid-cols-3">
            {related.map((p) => (
              <li key={p.slug}>
                <BlogCard post={p} />
              </li>
            ))}
          </ul>
        </Container>
      </Section>
    </>
  );
}
