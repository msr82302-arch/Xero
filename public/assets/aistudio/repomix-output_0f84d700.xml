import { buildMetadata, caseStudySchema } from "@/lib/seo";
import { Breadcrumbs } from "@/components/ui/breadcrumbs";
import { Container, Section } from "@/components/ui/container";
import { JsonLd } from "@/components/ui/json-ld";
import { Reveal } from "@/components/ui/reveal";
import { Enter, EnterText } from "@/components/ui/enter";
import { Eyebrow } from "@/components/ui/section-heading";
import { CaseStudyCard } from "@/components/cards/case-study-card";
import { Photo } from "@/components/visuals/photo";
import { CTASection } from "@/sections/cta-section";

export function generateStaticParams() {
  return caseStudies.map((c) => ({ slug: c.slug }));
}

export const dynamicParams = false;

export async function generateMetadata({ params }: PageProps<"/case-studies/[slug]">): Promise<Metadata> {
  const { slug } = await params;
  const cs = getCaseStudy(slug);
  if (!cs) return {};
  return buildMetadata({ title: `${cs.title} — Case Study`, description: cs.summary, path: `/case-studies/${slug}` });
}

export default async function CaseStudyPage({ params }: PageProps<"/case-studies/[slug]">) {
  const { slug } = await params;
  const cs = getCaseStudy(slug);
  if (!cs) notFound();

  const index = caseStudies.findIndex((c) => c.slug === slug);
  const next = caseStudies[(index + 1) % caseStudies.length];
  const more = caseStudies.filter((c) => c.slug !== slug && c.category === cs.category).concat(caseStudies.filter((c) => c.slug !== slug && c.category !== cs.category)).slice(0, 3);

  return (
    <>
      <JsonLd data={caseStudySchema(cs)} />
      <section className="relative overflow-hidden pt-32 pb-12 sm:pt-40">
        <div className="grid-bg absolute inset-0" aria-hidden />
        <div className="pointer-events-none absolute -top-40 right-0 size-[34rem] rounded-full opacity-30 blur-[120px]" style={{ background: cs.accent[1] }} aria-hidden />
        <Container className="relative">
          <Breadcrumbs items={[{ name: "Work", path: "/work" }, { name: cs.title, path: `/case-studies/${cs.slug}` }]} />
          <div className="mt-8 flex flex-wrap gap-2">
            <Eyebrow>{cs.category}</Eyebrow>
            <Eyebrow>{cs.industry}</Eyebrow>
          </div>
          <h1 className="mt-6 max-w-5xl text-4xl leading-[1.05] font-semibold sm:text-5xl lg:text-6xl">
            <EnterText text={cs.title} />
          </h1>
          <Enter delay={0.2}>
            <p className="mt-6 max-w-2xl text-lg text-muted">{cs.summary}</p>
          </Enter>
          {cs.isPlaceholder && (
            <p className="mt-6 inline-flex items-center gap-2 rounded-full border border-amber-500/40 dark:border-amber-300/30 bg-amber-300/10 px-4 py-2 text-xs text-amber-700 dark:text-amber-200">
              <Info className="size-3.5" aria-hidden /> Sample project — client and metrics are illustrative placeholders.
            </p>
          )}
        </Container>
      </section>

      <Container>
        <Enter delay={0.25} className="enter-scale">
          <Photo src={cs.image} alt={`Project visual for ${cs.title}`} sizes="(min-width: 1280px) 1216px, 100vw" priority zoom={false} className="relative aspect-[16/9] rounded-[2rem] border border-line" />
        </Enter>
        <dl className="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4">
          {[
            ["Client", cs.client],
            ["Industry", cs.industry],
            ["Duration", cs.duration],
            ["Year", cs.year],
          ].map(([k, v]) => (
            <div key={k} className="bg-ink-950 p-5">
              <dt className="text-xs text-subtle">{k}</dt>
              <dd className="mt-1 text-sm font-medium">{v}</dd>
            </div>
          ))}
        </dl>
      </Container>

      <Section>
        <Container className="grid gap-12 lg:grid-cols-[1fr_2fr]">
          <aside className="space-y-8 lg:sticky lg:top-28 lg:self-start">
            <div>
              <h2 className="text-xs tracking-wide text-subtle uppercase">Services provided</h2>
              <ul className="mt-3 space-y-2 text-sm">
                {cs.services.map((s) => (
                  <li key={s}>{s}</li>
                ))}
              </ul>
            </div>
            <div>
              <h2 className="text-xs tracking-wide text-subtle uppercase">Technologies</h2>
              <ul className="mt-3 flex flex-wrap gap-2">
                {cs.technologies.map((t) => (
                  <li key={t} className="rounded-full border border-line px-3 py-1 text-xs text-muted">
                    {t}
                  </li>
                ))}
              </ul>
            </div>
          </aside>
          <div className="space-y-14">
            <Reveal>
              <h2 className="text-2xl font-semibold sm:text-3xl">The challenge</h2>
              <p className="mt-4 text-lg leading-relaxed text-muted">{cs.challenge}</p>
            </Reveal>
            <Reveal>
              <h2 className="text-2xl font-semibold sm:text-3xl">Our solution</h2>
              <ol className="mt-6 space-y-4">
                {cs.solution.map((s, i) => (
                  <li key={s} className="flex gap-4 rounded-2xl border border-line bg-white/[0.02] p-5">
                    <span className="font-display text-sm text-violet">{String(i + 1).padStart(2, "0")}</span>
                    <span className="text-fg/85">{s}</span>
                  </li>
                ))}
              </ol>
            </Reveal>
            <Reveal>
              <h2 className="text-2xl font-semibold sm:text-3xl">Results</h2>
              <dl className="mt-6 grid gap-4 sm:grid-cols-3">
                {cs.results.map((r) => (
                  <div key={r.label} className="glass flex flex-col-reverse rounded-2xl p-6">
                    <dt className="mt-2 text-sm text-muted">{r.label}</dt>
                    <dd className="text-gradient-accent font-display text-4xl font-semibold">{r.value}</dd>
                  </div>
                ))}
              </dl>
            </Reveal>
          </div>
        </Container>
      </Section>

      <Container>
        <div className="flex items-center justify-between gap-4 border-y border-line py-8">
          <Link href="/work" className="inline-flex items-center gap-2 text-sm text-muted hover:text-fg">
            <ArrowLeft className="size-4" aria-hidden /> All work
          </Link>
          <Link href={`/case-studies/${next.slug}`} className="group inline-flex items-center gap-2 text-right text-sm">
            <span>
              <span className="block text-xs text-subtle">Next project</span>
              <span className="block font-medium">{next.title}</span>
            </span>
            <ArrowRight className="size-4 shrink-0 transition-transform group-hover:translate-x-1" aria-hidden />
          </Link>
        </div>
      </Container>

      <Section aria-labelledby="more-title">
        <Container>
          <h2 id="more-title" className="text-2xl font-semibold sm:text-3xl">
            More work
          </h2>
          <ul className="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {more.map((m) => (
              <li key={m.slug}>
                <CaseStudyCard study={m} />
              </li>
            ))}
          </ul>
        </Container>
      </Section>
      <CTASection title="Want results like these?" primary={{ label: "Start Your Project", href: "/book-consultation" }} />
    </>
  );
}
</file>

<file path="frontend/src/app/contact/page.tsx">
import type { Metadata } from "next";
import { Suspense } from "react";
import { Clock, Mail, MapPin, Phone } from "lucide-react";
import { siteConfig } from "@/data/site";
import { buildMetadata } from "@/lib/seo";
import { media } from "@/data/media";
import { Button } from "@/components/ui/button";
import { Container, Section } from "@/components/ui/container";
import { ContactForm } from "@/components/forms/contact-form";
import { PageHero } from "@/components/layout/page-hero";
import { SocialIcons } from "@/components/visuals/social-icons";

export const metadata: Metadata = buildMetadata({
  title: "Contact Us",
  description: `Get in touch with ${siteConfig.name}. Email, phone, business hours and a contact form — or book a free consultation.`,
  path: "/contact",
});

export default function ContactPage() {
  const { contact } = siteConfig;
  const items = [
    { icon: Mail, label: "Email", value: contact.email, href: `mailto:${contact.email}` },
    { icon: Phone, label: "Phone", value: contact.phone, href: contact.phoneHref },
    { icon: MapPin, label: "Location", value: `${contact.address.street}, ${contact.address.city}, ${contact.address.region} ${contact.address.postalCode}` },
  ];
  return (
    <>
      <PageHero
        eyebrow="Contact"
        title="Let's start a conversation."
        description="Questions, ideas or a project brief — we'd love to hear from you. We reply within one business day."
        breadcrumbs={[{ name: "Contact", path: "/contact" }]}
        media={{ type: "image", src: media.office.desk, alt: "A collaborative workspace from above" }}
      />
      <Section className="pt-0 sm:pt-0">
        <Container className="grid gap-10 lg:grid-cols-[1fr_1.5fr]">
          <div className="space-y-6">
            <ul className="space-y-3">
              {items.map((item) => {
                const Icon = item.icon;
                const content = (
                  <>
                    <span className="grid size-11 shrink-0 place-items-center rounded-xl border border-line bg-white/[0.03]">
                      <Icon className="size-4 text-cyan" aria-hidden />
                    </span>
                    <span>
                      <span className="block text-xs text-subtle">{item.label}</span>
                      <span className="block text-sm font-medium">{item.value}</span>
                    </span>
                  </>
                );
                return (
                  <li key={item.label}>
                    {item.href ? (
                      <a href={item.href} className="flex items-center gap-4 rounded-2xl border border-line p-4 transition hover:border-line-strong">
                        {content}
                      </a>
                    ) : (
                      <address className="flex items-center gap-4 rounded-2xl border border-line p-4 not-italic">{content}</address>
                    )}
                  </li>
                );
              })}
            </ul>

            <div className="rounded-2xl border border-line p-5">
              <p className="flex items-center gap-2 text-sm font-medium">
                <Clock className="size-4 text-cyan" aria-hidden /> Business hours ({contact.timezone.split("/")[1].replace("_", " ")} time)
              </p>
              <dl className="mt-4 space-y-2 text-sm">
                {contact.hours.map((h) => (
                  <div key={h.days} className="flex justify-between gap-4">
                    <dt className="text-muted">{h.days}</dt>
                    <dd>{h.time}</dd>
                  </div>
                ))}
              </dl>
            </div>

            {/* Google Maps placeholder — replace with an <iframe> embed (loading="lazy") once the address is final. */}
            <div className="relative grid aspect-[16/10] place-items-center overflow-hidden rounded-2xl border border-line bg-ink-900" role="img" aria-label="Map placeholder — office location">
              <div className="grid-bg absolute inset-0 opacity-80" aria-hidden />
              <div className="relative flex flex-col items-center gap-2 text-center">
                <span className="grid size-12 place-items-center rounded-full bg-accent-gradient text-snow shadow-[0_0_40px_rgba(139,92,246,0.6)]">
                  <MapPin className="size-5" aria-hidden />
                </span>
                <span className="text-sm font-medium">
                  {contact.address.city}, {contact.address.region}
                </span>
                <span className="text-xs text-subtle">Google Maps embed placeholder</span>
              </div>
            </div>

            <div className="flex flex-wrap items-center justify-between gap-4">
              <SocialIcons />
              <Button href="/book-consultation" variant="outline" arrow>
                Book a Consultation
              </Button>
            </div>
          </div>
          <Suspense fallback={<div className="h-[32rem] animate-pulse rounded-[2rem] border border-line bg-ink-900/60" />}>
            <ContactForm />
          </Suspense>
        </Container>
      </Section>
    </>
  );
}
</file>

