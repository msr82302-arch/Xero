# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional initial XBMS Administrator passcode.
# If left empty, the /admin sign-in gate prompts for first-run administrator setup.
ADMIN_PASSCODE=

# STAFF_PASSCODE: Optional initial XBMS Staff Billing Terminal passcode.
# If left empty, the /terminal sign-in gate prompts for first-run staff terminal setup.
STAFF_PASSCODE=

# STAFF_INVITE_CODE: Optional server-side authorization code for immediate Staff Terminal registration.
STAFF_INVITE_CODE=

# ADMIN_OVERRIDE_PIN: Optional server-side verification PIN for Staff Terminal account reactivation.
ADMIN_OVERRIDE_PIN=

